Ontology(<http://example.org/n>

Declaration(Class(:X))
Declaration(Class(:Y))
Declaration(ObjectProperty(:p))

############################
#   Classes
############################

# Class: :X (:X)

SubClassOf(:X owl:Thing)

# Class: :Y (:Y)

SubClassOf(:Y owl:Thing)
SubClassOf(:Y ObjectAllValuesFrom(:p owl:Nothing))

# Class: owl:Nothing (owl:Nothing)

SubClassOf(owl:Nothing owl:Nothing)


