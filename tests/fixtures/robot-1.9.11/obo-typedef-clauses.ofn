Prefix(:=<http://example.org/t#>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://purl.obolibrary.org/obo/t.owl>
Declaration(Class(:A))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(ObjectProperty(:s))
Declaration(AnnotationProperty(:m))
Declaration(AnnotationProperty(:n))
Declaration(AnnotationProperty(:k))
AnnotationAssertion(rdfs:label :A "  ")
AnnotationAssertion(rdfs:label :p "p")
TransitiveObjectProperty(Annotation(rdfs:comment "t") :p)
FunctionalObjectProperty(ObjectInverseOf(:p))
SymmetricObjectProperty(:s)
AsymmetricObjectProperty(Annotation(rdfs:comment "a") :s)
ObjectPropertyDomain(:q owl:Thing)
ObjectPropertyDomain(Annotation(rdfs:comment "d") :r :A)
ObjectPropertyDomain(ObjectInverseOf(:s) :A)
ObjectPropertyDomain(:s ObjectSomeValuesFrom(:p :A))
SubObjectPropertyOf(:q owl:topObjectProperty)
SubObjectPropertyOf(:q owl:sameAs)
SubObjectPropertyOf(:s owl:bottomObjectProperty)
SubObjectPropertyOf(Annotation(rdfs:comment "sub") :r :q)
EquivalentObjectProperties(:q owl:bottomObjectProperty)
SubObjectPropertyOf(ObjectPropertyChain(:p owl:topObjectProperty) :q)
InverseObjectProperties(Annotation(rdfs:comment "inv") :p :r)
InverseObjectProperties(:q ObjectInverseOf(:s))
SubObjectPropertyOf(:u :v)
AnnotationAssertion(rdfs:label :u "u")
AnnotationAssertion(oboInOwl:is_metadata_tag :m "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label :m "m")
SubAnnotationPropertyOf(:m :n)
AnnotationAssertion(oboInOwl:is_metadata_tag :k "false"^^xsd:boolean)
AnnotationAssertion(rdfs:label :k "k")
AnnotationAssertion(:n :k _:x)
)
