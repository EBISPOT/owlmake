Prefix(:=<http://example.org/rename-entities#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://example.org/rename-entities>
Annotation(rdfs:seeAlso :A)
Annotation(Annotation(rdfs:seeAlso :A) rdfs:comment "an ontology annotation on an annotation")
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:p))
Declaration(DataProperty(:d))
Declaration(AnnotationProperty(:ap))
Declaration(NamedIndividual(:i))
Declaration(Datatype(:dt))
AnnotationAssertion(rdfs:label :A "a")
AnnotationAssertion(rdfs:label :B "b")
AnnotationAssertion(rdfs:seeAlso :B :A)
AnnotationAssertion(Annotation(rdfs:seeAlso :A) rdfs:comment :C "an IRI value in an annotation")
AnnotationAssertion(rdfs:comment :undeclared "about an IRI no entity has")
AnnotationAssertion(:ap :C "a value of the property")
SubClassOf(Annotation(rdfs:seeAlso :A) :B :C)
SubClassOf(:A ObjectSomeValuesFrom(:p :B))
DataPropertyAssertion(:d :i "1"^^:dt)
DatatypeDefinition(:dt xsd:integer)
ClassAssertion(:A _:x)
ObjectPropertyAssertion(:p _:x :i)
)
