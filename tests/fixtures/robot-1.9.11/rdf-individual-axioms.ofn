Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/i>
Declaration(Class(i:A))
Declaration(Class(i:B))
Declaration(Class(i:C))
Declaration(ObjectProperty(i:p))
Declaration(ObjectProperty(i:q))
Declaration(DataProperty(i:d))
Declaration(DataProperty(i:e))
Declaration(NamedIndividual(i:a))
Declaration(NamedIndividual(i:b))
Declaration(NamedIndividual(i:c))
ClassAssertion(Annotation(rdfs:comment "typed") i:A i:a)
ClassAssertion(i:B i:a)
ClassAssertion(Annotation(rdfs:comment "restricted") ObjectSomeValuesFrom(i:p i:B) i:a)
ObjectPropertyAssertion(Annotation(rdfs:comment "related") i:p i:a i:b)
ObjectPropertyAssertion(ObjectInverseOf(i:q) i:a i:c)
DataPropertyAssertion(Annotation(rdfs:comment "valued") i:d i:a "1"^^xsd:integer)
NegativeObjectPropertyAssertion(i:q i:b i:c)
NegativeDataPropertyAssertion(i:e i:b "2"^^xsd:integer)
SameIndividual(i:c i:b)
DifferentIndividuals(Annotation(rdfs:comment "different") i:c i:a)
AnnotationAssertion(Annotation(rdfs:comment "label") rdfs:label i:a "a")
ClassAssertion(i:C _:x)
AnnotationAssertion(rdfs:comment _:x "anonymous")
EquivalentClasses(Annotation(rdfs:comment "counter") ObjectSomeValuesFrom(i:p i:C) ObjectAllValuesFrom(i:p i:C))
)
