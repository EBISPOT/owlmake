Prefix(:=<http://example.org/dupann#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/dupann>

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(NamedIndividual(:j))


############################
#   Classes
############################

# Class: :A (:A)

SubClassOf(:A :B)
SubClassOf(Annotation(rdfs:comment "x") :A :B)

# Class: :B (:B)

SubClassOf(:B owl:Thing)


############################
#   Named Individuals
############################

# Individual: :j (:j)

ClassAssertion(:A :j)
ClassAssertion(Annotation(rdfs:comment "y") :A :j)


)