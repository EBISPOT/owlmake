Prefix(:=<http://example.org/r#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/key2>
Declaration(Class(:A))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:p))
Declaration(DataProperty(:e))
Declaration(DataProperty(:d))
Declaration(NamedIndividual(:x))
Declaration(NamedIndividual(:y))
Declaration(NamedIndividual(:z))
HasKey(:A (:q :p) (:e :d))
ClassAssertion(:A :x)
ClassAssertion(:A :y)
ObjectPropertyAssertion(:p :x :z)
ObjectPropertyAssertion(:p :y :z)
ObjectPropertyAssertion(:q :x :z)
ObjectPropertyAssertion(:q :y :z)
DataPropertyAssertion(:d :x "1"^^xsd:integer)
DataPropertyAssertion(:d :y "1"^^xsd:integer)
DataPropertyAssertion(:e :x "1"^^xsd:integer)
DataPropertyAssertion(:e :y "1"^^xsd:integer)
DifferentIndividuals(:x :y)
)
