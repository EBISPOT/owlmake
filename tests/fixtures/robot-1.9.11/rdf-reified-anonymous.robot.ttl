@prefix : <http://example.org/reified-anonymous#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/reified-anonymous> .

<http://example.org/reified-anonymous> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/reified-anonymous#p
:p rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/reified-anonymous#C
:C rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/reified-anonymous#i
:i rdf:type owl:NamedIndividual ;
   owl:sameAs _:genid1 ;
   owl:differentFrom _:genid3 ;
   :p _:genid5 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :i ;
   owl:annotatedProperty owl:sameAs ;
   owl:annotatedTarget _:genid1 ;
   rdfs:comment "same"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :i ;
   owl:annotatedProperty owl:differentFrom ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "different"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :i ;
   owl:annotatedProperty :p ;
   owl:annotatedTarget _:genid5 ;
   rdfs:comment "related"
 ] .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type :C ;
                        rdfs:label "labelled"
                      ] ;
  owl:annotatedProperty rdf:type ;
  owl:annotatedTarget :C ;
  rdfs:comment "typed with a label"
] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ rdf:type :C
                       ] ;
   owl:annotatedProperty rdf:type ;
   owl:annotatedTarget :C ;
   rdfs:comment "typed alone"
 ] .

