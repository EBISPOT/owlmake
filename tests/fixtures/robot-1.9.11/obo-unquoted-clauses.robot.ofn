############################

# Annotation Property: <http://purl.obolibrary.org/obo/IAO_0000115> (definition)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/IAO_0000115> "definition")

# Annotation Property: <http://purl.obolibrary.org/obo/q#s1> (<http://purl.obolibrary.org/obo/q#s1>)

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/q#s1> "subset one")
SubAnnotationPropertyOf(Annotation(rdfs:comment "sc") <http://purl.obolibrary.org/obo/q#s1> <http://www.geneontology.org/formats/oboInOwl#SubsetProperty>)

# Annotation Property: <http://purl.obolibrary.org/obo/q#st1> (type one)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasScope> <http://purl.obolibrary.org/obo/q#st1> <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym>)
