#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/R_1> (rel)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#a> "b") <http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/R_1> "z")
AnnotationAssertion(Annotation(rdfs:comment "x") <http://www.geneontology.org/formats/oboInOwl#custom_tag> <http://purl.obolibrary.org/obo/R_1> "v")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#disjoint_over> <http://purl.obolibrary.org/obo/R_1> "R:2")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/R_1> "R:1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/R_1> <http://purl.obolibrary.org/obo/q#s1>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#transitive> <http://purl.obolibrary.org/obo/R_1> "true")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "s") rdfs:comment <http://purl.obolibrary.org/obo/R_1> "c")
AnnotationAssertion(Annotation(rdfs:comment "x") rdfs:label <http://purl.obolibrary.org/obo/R_1> "rel")

# Object Property: <http://purl.obolibrary.org/obo/R_2> (<http://purl.obolibrary.org/obo/R_2>)

