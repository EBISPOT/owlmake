# Class: <http://purl.obolibrary.org/obo/Q_0000001> (a b)

AnnotationAssertion(Annotation(rdfs:comment "x") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/Q_0000001> "d")
AnnotationAssertion(Annotation(rdfs:comment "q") <http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/Q_0000001> "someone")
AnnotationAssertion(Annotation(rdfs:comment "d") <http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/Q_0000001> "2020-01-01T00:00:00Z")
AnnotationAssertion(Annotation(rdfs:comment "x") Annotation(rdfs:label "z") Annotation(rdfs:seeAlso "y") <http://www.geneontology.org/formats/oboInOwl#foo_bar> <http://purl.obolibrary.org/obo/Q_0000001> "baz{1}")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "s") <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/Q_0000001> "Q:0000009")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/Q_0000001> "X:2")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "X:1") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/Q_0000001> "syn one")
AnnotationAssertion(Annotation(rdfs:comment "n") <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/Q_0000001> "ns1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/Q_0000001> "unquoted text")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/Q_0000001> "Q:0000001")
AnnotationAssertion(Annotation(rdfs:comment "x") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/Q_0000001> <http://purl.obolibrary.org/obo/q#s1>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/Q_0000001> "He said \"a")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#seeAlso> "z") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "s2") Annotation(rdfs:comment "x}y") rdfs:label <http://purl.obolibrary.org/obo/Q_0000001> "a b")
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/Q_0000001> "x")
SubClassOf(<http://purl.obolibrary.org/obo/Q_0000001> owl:Thing)

# Class: <http://purl.obolibrary.org/obo/Q_0000002> (x	y
# z)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/Q_0000002> "Q:0000002")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "X:3") rdfs:comment <http://purl.obolibrary.org/obo/Q_0000002> "tabs	and {braces}")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/Q_0000002> "x	y
z")

# Class: <http://purl.obolibrary.org/obo/Q_0000009> (<http://purl.obolibrary.org/obo/Q_0000009>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000231> <http://purl.obolibrary.org/obo/Q_0000009> <http://purl.obolibrary.org/obo/IAO_0000227>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0100001> <http://purl.obolibrary.org/obo/Q_0000009> <http://purl.obolibrary.org/obo/Q_0000001>)
