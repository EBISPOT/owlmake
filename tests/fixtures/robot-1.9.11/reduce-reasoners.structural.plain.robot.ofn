############################
#   Object Properties
############################

# Object Property: :bq (:bq)

SubObjectPropertyOf(:bq :bp)

# Object Property: :bt (:bt)

TransitiveObjectProperty(:bt)

# Object Property: :df (:df)

FunctionalObjectProperty(:df)



############################
#   Classes
############################

# Class: :aA (:aA)

EquivalentClasses(:aA :aB)
SubClassOf(:aA :aB)
SubClassOf(:aA :aD)

# Class: :aC (:aC)

SubClassOf(:aC :aY)

# Class: :aD1 (:aD1)

SubClassOf(:aD1 :aD)

