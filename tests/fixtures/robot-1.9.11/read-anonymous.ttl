@prefix : <http://example.org/r#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/r> .

<http://example.org/r> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/r#p
:p rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/r#A
:A rdf:type owl:Class ;
   rdfs:subClassOf [ rdf:type owl:Restriction ;
                     owl:onProperty :p ;
                     owl:hasValue [ rdf:type :C
                                  ]
                   ] .


###  http://example.org/r#B
:B rdf:type owl:Class ;
   rdfs:subClassOf [ rdf:type owl:Class ;
                     owl:oneOf ( :i
                                 [ ]
                     )
   ] .


###  http://example.org/r#C
:C rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/r#i
:i rdf:type owl:NamedIndividual ;
   owl:sameAs [ ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual :i ;
   owl:assertionProperty :p ;
   owl:targetIndividual [ ]
] .


###  http://example.org/r#j
:j rdf:type owl:NamedIndividual ;
   owl:differentFrom [ ] .


[ rdf:type owl:NegativePropertyAssertion ;
  owl:sourceIndividual [ ] ;
owl:assertionProperty :p ;
owl:targetIndividual :j
] .

