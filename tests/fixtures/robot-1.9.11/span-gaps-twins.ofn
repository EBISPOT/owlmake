Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/props.owl>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(Class(:D))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(DataProperty(:d))
Declaration(DataProperty(:e))
Declaration(AnnotationProperty(:x))
Declaration(AnnotationProperty(:y))
SubClassOf(:B :A)
SubClassOf(:C :B)
SubClassOf(Annotation(rdfs:comment "kept") :C :D)
SubObjectPropertyOf(Annotation(rdfs:comment "ann") :p :q)
SubObjectPropertyOf(:r ObjectInverseOf(:q))
SubDataPropertyOf(Annotation(rdfs:comment "ann") :d :e)
SubAnnotationPropertyOf(Annotation(rdfs:comment "ann") :x :y)
)
