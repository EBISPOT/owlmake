Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(
Declaration(ObjectProperty(<http://example.org/x>))
Declaration(ObjectProperty(<http://example.org/x#OP1>))

############################
#   Object Properties
############################

# Object Property: <http://example.org/x#OP1> (o p one)

AnnotationAssertion(rdfs:label <http://example.org/x#OP1> "o p one")
SubObjectPropertyOf(<http://example.org/x#OP1> <http://example.org/x>)



)