###  http://example.org/typed-strings#D
:D rdf:type owl:Class ;
   rdfs:label "z" ,
              "z"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :D ;
   owl:annotatedProperty rdfs:label ;
   owl:annotatedTarget "z"@en ;
   rdfs:comment "c"@en ,
                "c"
 ] .


###  http://example.org/typed-strings#E
:E rdf:type owl:Class ;
   rdfs:label "x"@en ,
              "x" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :E ;
   owl:annotatedProperty rdfs:label ;
   owl:annotatedTarget "x" ;
   rdfs:comment "c1"
 ] .


###  http://example.org/typed-strings#F
:F rdf:type owl:Class ;
   rdfs:label "w" ,
              "w"@en .

[ rdf:type owl:Axiom ;
