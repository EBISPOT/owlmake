###  http://example.org/xml-literal#A
:A rdf:type owl:Class ;
   rdfs:comment "<b xmlns=\"http://example.org/b\">bold &amp; <i>x</i></b>"^^rdf:XMLLiteral ;
   rdfs:seeAlso "<owl:Thing xmlns:owl=\"http://www.w3.org/2002/07/owl#\"/>"^^rdf:XMLLiteral .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget "<owl:Thing xmlns:owl=\"http://www.w3.org/2002/07/owl#\"/>"^^rdf:XMLLiteral ;
   rdfs:label "annotated"
 ] .


