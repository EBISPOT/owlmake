############################
#   Object Properties
############################

# Object Property: :f (:f)

FunctionalObjectProperty(:f)


############################
#   Classes
############################

# Class: :A (:A)

SubClassOf(:A ObjectSomeValuesFrom(:p :B))
SubClassOf(:A ObjectAllValuesFrom(:p :C))

# Class: :D (:D)

SubClassOf(:D ObjectUnionOf(:E :F))
SubClassOf(:D ObjectSomeValuesFrom(:q :G))

# Class: :E (:E)

SubClassOf(:E ObjectSomeValuesFrom(:q :G))

# Class: :F (:F)

SubClassOf(:F ObjectSomeValuesFrom(:q :G))

# Class: :H (:H)

SubClassOf(:H ObjectSomeValuesFrom(:f :B))
SubClassOf(:H ObjectSomeValuesFrom(:f :G))

# Class: :K (:K)

EquivalentClasses(:K ObjectIntersectionOf(:B :G))
SubClassOf(:K :B)
SubClassOf(:K :G)

# Class: :L (:L)

EquivalentClasses(:L ObjectIntersectionOf(:M ObjectSomeValuesFrom(:p :N)))
SubClassOf(:L :M)
SubClassOf(:L ObjectSomeValuesFrom(:p :N))

# Class: :N (:N)

SubClassOf(:N ObjectSomeValuesFrom(:q :K))

# Class: :P (:P)

SubClassOf(:P :Q)

# Class: :Q (:Q)

SubClassOf(:Q :P)

# Class: :R (:R)

SubClassOf(:R :P)

# Class: :S (:S)

EquivalentClasses(:S ObjectSomeValuesFrom(:q :R))
SubClassOf(:S ObjectSomeValuesFrom(:q :Q))

# Class: :T (:T)

SubClassOf(:T :S)
SubClassOf(:T ObjectSomeValuesFrom(:q :R))

# Class: :U (:U)

EquivalentClasses(:U ObjectUnionOf(:V :W))
SubClassOf(:U ObjectSomeValuesFrom(:p :A))


