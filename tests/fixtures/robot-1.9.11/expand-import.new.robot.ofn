#   Classes
############################

# Class: <http://example.org/x#A> (<http://example.org/x#A>)

SubClassOf(<http://example.org/x#A> ObjectSomeValuesFrom(obo:RO_0002162 ObjectComplementOf(<http://example.org/x#T>)))
DisjointClasses(<http://example.org/x#A> ObjectSomeValuesFrom(obo:RO_0002162 <http://example.org/x#T>))

# Class: <http://example.org/x#B> (<http://example.org/x#B>)

