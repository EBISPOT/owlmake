Prefix(:=<http://example.org/explain-self#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/explain-self>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(ObjectProperty(:p))
