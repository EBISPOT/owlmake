Prefix(:=<http://example.org/md#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<http://example.org/md>
Annotation(Annotation(rdfs:comment "nested") rdfs:label "onto")
Annotation(rdfs:comment "a<b>&amp;")
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(DataProperty(:d))
Declaration(NamedIndividual(:i))
Declaration(Datatype(:t))
Declaration(Datatype(:t2))
AnnotationAssertion(rdfs:label :A "same")
AnnotationAssertion(rdfs:label :B "same")
AnnotationAssertion(rdfs:label :C "a<b & \"c\" [x]")
AnnotationAssertion(rdfs:label :p "pee")
SubClassOf(:A ObjectHasSelf(:p))
SubClassOf(:A ObjectSomeValuesFrom(:p ObjectIntersectionOf(:B :C)))
SubClassOf(:A ObjectAllValuesFrom(:p ObjectUnionOf(:B ObjectComplementOf(:C))))
SubClassOf(:A ObjectSomeValuesFrom(:p ObjectSomeValuesFrom(:q :C)))
SubClassOf(:B ObjectExactCardinality(2 :p))
SubClassOf(:B ObjectMinCardinality(1 :p :C))
SubClassOf(:B ObjectMaxCardinality(1 :p ObjectIntersectionOf(:A :C)))
SubClassOf(:B DataMaxCardinality(3 :d))
SubClassOf(:B DataExactCardinality(1 :d xsd:boolean))
SubClassOf(:C DataAllValuesFrom(:d DataComplementOf(xsd:integer)))
SubClassOf(:C DataAllValuesFrom(:d DataComplementOf(DataOneOf("1"^^xsd:integer))))
SubClassOf(:C DataSomeValuesFrom(:d DataIntersectionOf(xsd:integer DatatypeRestriction(xsd:integer xsd:minExclusive "0"^^xsd:integer))))
SubClassOf(:C DataHasValue(:d "1.5"^^xsd:float))
SubClassOf(:C DataHasValue(:d "true"^^xsd:boolean))
SubClassOf(:C DataHasValue(:d "2.5"^^xsd:double))
SubClassOf(:C DataHasValue(:d "<&>"@en))
SubClassOf(:C ObjectOneOf(:i _:x))
SubObjectPropertyOf(ObjectInverseOf(:p) :q)
FunctionalObjectProperty(ObjectInverseOf(:q))
InverseObjectProperties(ObjectInverseOf(:p) :q)
EquivalentObjectProperties(ObjectInverseOf(:p) :r)
EquivalentClasses(ObjectSomeValuesFrom(:p :A) ObjectSomeValuesFrom(:q :B))
SubClassOf(ObjectUnionOf(:A :B) :C)
HasKey(ObjectSomeValuesFrom(:p :A) (:p) ())
DatatypeDefinition(:t xsd:integer)
DatatypeDefinition(:t2 DataUnionOf(xsd:string xsd:integer))
DisjointClasses(:A :B :C)
DifferentIndividuals(_:y _:z)
AnnotationAssertion(rdfs:comment _:y "anon y")
ClassAssertion(:A _:z)
DLSafeRule(Body(ClassAtom(ObjectSomeValuesFrom(:p :A) Variable(:v)) DataRangeAtom(xsd:integer Variable(:x)) BuiltInAtom(<http://example.org/md#myBuiltin> Variable(:x) "1"^^xsd:integer) ObjectPropertyAtom(:p Variable(:v) :i) DataPropertyAtom(:d Variable(:v) "lit")) Head(DifferentIndividualsAtom(Variable(:v) :i)))
AnnotationAssertion(rdfs:comment <http://example.org/md/iri-subject> "about an IRI")
SubClassOf(Annotation(Annotation(rdfs:comment "deep") rdfs:comment "c1") Annotation(rdfs:label "c2") Annotation(rdfs:seeAlso :B) Annotation(rdfs:comment "c3"^^xsd:string) :C :A)
)
