Prefix(:=<http://example.org/repeated-operands#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/repeated-operands>

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:p))
Declaration(DataProperty(:d))
Declaration(NamedIndividual(:j))
Declaration(NamedIndividual(:k))
Declaration(NamedIndividual(:m))
############################
#   Object Properties
############################

# Object Property: :p (:p)




############################
#   Data Properties
############################

# Data Property: :d (:d)





############################
#   Classes
############################

# Class: :A (:A)

SubClassOf(:A owl:Thing)
DisjointClasses(:A :B)

# Class: :B (:B)

SubClassOf(:B owl:Thing)

# Class: :C (:C)

SubClassOf(:C :A)


############################
#   Named Individuals
############################

# Individual: :j (:j)

ObjectPropertyAssertion(:p :j :k)

# Individual: :k (:k)

ClassAssertion(:A :k)

# Individual: :m (:m)

DataPropertyAssertion(:d :m "x")



DifferentIndividuals(:j :k)
)