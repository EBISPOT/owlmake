Prefix(:=<http://example.org/a#>)
Prefix(a:=<http://example.org/a#>)
Prefix(dc:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/a>
Annotation(Annotation(rdfs:comment "by whom") dc:creator "someone")
Annotation(Annotation(rdfs:comment "reviewed") rdfs:comment "about")
Annotation(Annotation(rdfs:comment "translated") rdfs:label "a"@en)

Declaration(Class(a:A))
Declaration(Class(a:B))
Declaration(Class(a:C))
Declaration(ObjectProperty(a:p))
Declaration(DataProperty(a:d))
Declaration(NamedIndividual(a:i))
Declaration(NamedIndividual(a:j))
Declaration(NamedIndividual(a:k))
Declaration(AnnotationProperty(a:ap))
Declaration(AnnotationProperty(dc:creator))




############################
#   Classes
############################

# Class: a:A (a:A)

AnnotationAssertion(Annotation(Annotation(rdfs:comment "checked") rdfs:comment "source") a:ap a:A "value")
SubClassOf(Annotation(Annotation(Annotation(rdfs:comment "deepest") rdfs:comment "deeper") rdfs:comment "deep") a:A a:B)
SubClassOf(Annotation(Annotation(Annotation(rdfs:comment "m1") rdfs:comment "n1") Annotation(rdfs:label "n2") rdfs:comment "branch") Annotation(rdfs:label "plain") a:A a:C)

# Class: a:B (a:B)

EquivalentClasses(Annotation(Annotation(rdfs:seeAlso <http://example.org/why>) rdfs:seeAlso <http://example.org/where>) a:B ObjectSomeValuesFrom(a:p a:C))

# Class: a:C (a:C)



############################
#   Named Individuals
############################

# Individual: a:i (a:i)

SameIndividual(Annotation(rdfs:comment "same") a:i a:j)
NegativeObjectPropertyAssertion(Annotation(Annotation(rdfs:comment "not") rdfs:comment "negative") a:p a:i a:k)

# Individual: a:j (a:j)

SameIndividual(Annotation(Annotation(rdfs:comment "shared") rdfs:comment "same") a:j a:k)
ObjectPropertyAssertion(Annotation(Annotation(rdfs:comment "first") rdfs:comment "a") a:p a:j a:i)
ObjectPropertyAssertion(Annotation(Annotation(rdfs:comment "second") rdfs:comment "b") a:p a:j a:i)
ObjectPropertyAssertion(Annotation(rdfs:comment "c") a:p a:j a:i)
DataPropertyAssertion(Annotation(rdfs:comment "w") a:d a:j "1")
DataPropertyAssertion(Annotation(rdfs:comment "x") a:d a:j "1")
DataPropertyAssertion(Annotation(Annotation(rdfs:comment "later") rdfs:comment "y") a:d a:j "1")


SubClassOf(Annotation(Annotation(rdfs:comment "general") rdfs:comment "gci") ObjectSomeValuesFrom(a:p a:A) a:B)
DisjointClasses(Annotation(Annotation(rdfs:comment "all") rdfs:comment "disjoint") a:A a:B a:C)
AnnotationAssertion(Annotation(Annotation(rdfs:comment "untyped") rdfs:comment "label") rdfs:label a:undeclared "u")
)