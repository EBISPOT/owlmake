#################################################################
#    General axioms
#################################################################

[ rdf:type owl:NegativePropertyAssertion ;
  owl:sourceIndividual _:genid2 ;
  owl:assertionProperty g:op3 ;
  owl:targetIndividual [ ] ;
rdfs:seeAlso _:genid5
] .

[ rdf:type owl:Annotation ;
   owl:annotatedSource _:genid6 ;
   owl:annotatedProperty g:ap2 ;
   owl:annotatedTarget 6 ;
   rdfs:seeAlso "v20"
 ] .

_:genid6 rdf:type owl:Axiom ;
          owl:annotatedSource [ rdf:type owl:Restriction ;
                                owl:onProperty g:op3 ;
                                owl:hasValue _:genid2 ;
                                rdfs:subClassOf g:C4
                              ] ;
          owl:annotatedProperty rdfs:subClassOf ;
          owl:annotatedTarget g:C4 ;
          g:ap2 6 .


