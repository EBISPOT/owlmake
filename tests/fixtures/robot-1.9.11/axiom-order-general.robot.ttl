@prefix : <http://example.org/leftover.owl#> .
@prefix e: <http://example.org/ext/> .
@prefix i: <http://example.org/int/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/leftover.owl> .

<http://example.org/leftover.owl> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/ext/q
e:q rdf:type owl:ObjectProperty .

[ owl:inverseOf e:q ;
   rdfs:subPropertyOf i:p
 ] .


###  http://example.org/ext/r
e:r rdf:type owl:ObjectProperty .


###  http://example.org/int/p
i:p rdf:type owl:ObjectProperty .

[ owl:inverseOf i:p ;
   rdfs:subPropertyOf e:r
 ] .


###  http://x.org/p_b
<http://x.org/p_b> rdf:type owl:ObjectProperty .

[ owl:inverseOf <http://x.org/p_b> ;
   rdfs:subPropertyOf e:q
 ] .

[ owl:inverseOf <http://x.org/p_b> ;
   rdf:type owl:FunctionalProperty
 ] .

[ owl:inverseOf <http://x.org/p_b> ;
   rdf:type owl:TransitiveProperty
 ] .

[ owl:inverseOf <http://x.org/p_b> ;
   rdfs:domain i:A
 ] .

[ owl:inverseOf <http://x.org/p_b> ;
   rdfs:range i:A
 ] .


###  http://x.org/p/c
<http://x.org/p/c> rdf:type owl:ObjectProperty .

[ owl:inverseOf <http://x.org/p/c> ;
   rdf:type owl:TransitiveProperty
 ] .

[ owl:inverseOf <http://x.org/p/c> ;
   rdfs:domain e:B
 ] .

[ owl:inverseOf <http://x.org/p/c> ;
   rdfs:range e:B
 ] .

[ owl:inverseOf <http://x.org/p/c> ;
   rdfs:subPropertyOf e:r
 ] .

[ owl:inverseOf <http://x.org/p/c> ;
   rdf:type owl:FunctionalProperty
 ] .


#################################################################
#    Data properties
#################################################################

###  http://example.org/ext/d2
e:d2 rdf:type owl:DatatypeProperty .


###  http://example.org/int/d
i:d rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/ext/B
e:B rdf:type owl:Class .


###  http://example.org/int/A
i:A rdf:type owl:Class ;
    owl:hasKey ( e:q
               ) ,
               ( i:p
               ) .


###  http://x.org/a_b
<http://x.org/a_b> rdf:type owl:Class ;
                   owl:hasKey ( i:d
                              ) .


###  http://x.org/a/c
<http://x.org/a/c> rdf:type owl:Class ;
                   owl:hasKey ( e:d2
                              ) .


#################################################################
#    Individuals
#################################################################

###  http://example.org/int/y
i:y rdf:type owl:NamedIndividual .


[ rdf:type owl:NegativePropertyAssertion ;
  owl:sourceIndividual _:genid17 ;
  owl:assertionProperty i:p ;
  owl:targetIndividual i:y
] .

_:genid17 rdf:type i:A ;
           i:p i:y ;
           i:d "1" ;
           rdfs:label "x" .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual _:genid17 ;
   owl:assertionProperty i:d ;
   owl:targetValue "1"
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual _:genid20 ;
   owl:assertionProperty e:q ;
   owl:targetIndividual i:y
 ] .

_:genid20 rdf:type e:B ;
           e:q i:y ;
           e:d2 "2" ;
           rdfs:comment "y" .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual _:genid20 ;
   owl:assertionProperty e:d2 ;
   owl:targetValue "2"
 ] .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
   owl:onProperty <http://x.org/p_b> ;
   owl:someValuesFrom i:A ;
   rdfs:subClassOf e:B
 ] .


[ rdf:type owl:Restriction ;
  owl:onProperty <http://x.org/p/c> ;
  owl:someValuesFrom i:A ;
  rdfs:subClassOf e:B
] .


