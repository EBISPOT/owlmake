Prefix(:=<http://purl.obolibrary.org/obo/lits.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://purl.obolibrary.org/obo/lits.owl>
Annotation(<http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> "1.2")

Declaration(Class(<http://purl.obolibrary.org/obo/LITS_0000001>))
Declaration(AnnotationProperty(<http://purl.obolibrary.org/obo/LITS_dp>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#id>))
Declaration(AnnotationProperty(rdfs:label))
############################
#   Annotation Properties
############################

# Annotation Property: <http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> (has_obo_format_version)

AnnotationAssertion(rdfs:label <http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> "has_obo_format_version")

# Annotation Property: <http://www.geneontology.org/formats/oboInOwl#id> (id)

AnnotationAssertion(rdfs:label <http://www.geneontology.org/formats/oboInOwl#id> "id")



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/LITS_0000001> (one)

AnnotationAssertion(<http://purl.obolibrary.org/obo/LITS_dp> <http://purl.obolibrary.org/obo/LITS_0000001> "true"^^xsd:boolean)
AnnotationAssertion(<http://purl.obolibrary.org/obo/LITS_dp> <http://purl.obolibrary.org/obo/LITS_0000001> "2000.0"^^xsd:double)
AnnotationAssertion(<http://purl.obolibrary.org/obo/LITS_dp> <http://purl.obolibrary.org/obo/LITS_0000001> "1.0"^^xsd:float)
AnnotationAssertion(<http://purl.obolibrary.org/obo/LITS_dp> <http://purl.obolibrary.org/obo/LITS_0000001> "007"^^xsd:integer)
AnnotationAssertion(<http://purl.obolibrary.org/obo/LITS_dp> <http://purl.obolibrary.org/obo/LITS_0000001> "5"^^xsd:integer)
AnnotationAssertion(<http://purl.obolibrary.org/obo/LITS_dp> <http://purl.obolibrary.org/obo/LITS_0000001> "s1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/LITS_0000001> "LITS:0000001")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/LITS_0000001> "one")


)