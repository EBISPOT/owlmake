@prefix : <http://example.org/i#> .
@prefix i: <http://example.org/i#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/i> .

<http://example.org/i> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/i#p
i:p rdf:type owl:ObjectProperty .


###  http://example.org/i#q
i:q rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.org/i#d
i:d rdf:type owl:DatatypeProperty .


###  http://example.org/i#e
i:e rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/i#A
i:A rdf:type owl:Class .


###  http://example.org/i#B
i:B rdf:type owl:Class .


###  http://example.org/i#C
i:C rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/i#a
i:a rdf:type owl:NamedIndividual ,
             i:A ,
             i:B ,
             _:genid2 ;
    owl:differentFrom i:c ;
    i:p i:b ;
    i:d 1 ;
    rdfs:label "a" .

_:genid2 rdf:type owl:Restriction ;
          owl:onProperty i:p ;
          owl:someValuesFrom i:B .

[ rdf:type owl:Axiom ;
   owl:annotatedSource i:a ;
   owl:annotatedProperty rdf:type ;
   owl:annotatedTarget i:A ;
   rdfs:comment "typed"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource i:a ;
   owl:annotatedProperty rdf:type ;
   owl:annotatedTarget _:genid2 ;
   rdfs:comment "restricted"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource i:a ;
   owl:annotatedProperty owl:differentFrom ;
   owl:annotatedTarget i:c ;
   rdfs:comment "different"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource i:a ;
   owl:annotatedProperty i:p ;
   owl:annotatedTarget i:b ;
   rdfs:comment "related"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource i:a ;
   owl:annotatedProperty i:d ;
   owl:annotatedTarget 1 ;
   rdfs:comment "valued"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource i:a ;
   owl:annotatedProperty rdfs:label ;
   owl:annotatedTarget "a" ;
   rdfs:comment "label"
 ] .


###  http://example.org/i#b
i:b rdf:type owl:NamedIndividual ;
    owl:sameAs i:c .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual i:b ;
   owl:assertionProperty i:q ;
   owl:targetIndividual i:c
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual i:b ;
   owl:assertionProperty i:e ;
   owl:targetValue 2
 ] .


###  http://example.org/i#c
[ rdf:type owl:NegativePropertyAssertion ;
  owl:sourceIndividual i:b ;
  owl:assertionProperty i:q ;
  owl:targetIndividual i:c
] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual i:b ;
   owl:assertionProperty i:e ;
   owl:targetValue 2
 ] .


###  http://example.org/i#c
i:c rdf:type owl:NamedIndividual ;
    i:q i:a .


[ rdf:type i:C ;
  rdfs:comment "anonymous"
] .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ rdf:type owl:Restriction ;
                         owl:onProperty i:p ;
                         owl:someValuesFrom i:C ;
                         owl:equivalentClass _:genid12
                       ] ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid12 ;
   rdfs:comment "counter"
 ] .

_:genid12 rdf:type owl:Restriction ;
           owl:onProperty i:p ;
           owl:allValuesFrom i:C .


