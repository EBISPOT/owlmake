Prefix(:=<http://example.org/all-disjoint-inverse#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/all-disjoint-inverse.owl>
Declaration(ObjectProperty(:a))
Declaration(ObjectProperty(:b))
Declaration(ObjectProperty(:c))
Declaration(ObjectProperty(:d))
Declaration(ObjectProperty(:e))
Declaration(Class(:K))
DisjointObjectProperties(:a ObjectInverseOf(:c) ObjectInverseOf(:b))
DisjointObjectProperties(Annotation(rdfs:comment "annotated") Annotation(Annotation(rdfs:comment "nested") rdfs:seeAlso "x") :a :d ObjectInverseOf(:c))
DisjointObjectProperties(:a :b :e)
SubObjectPropertyOf(ObjectInverseOf(:b) :d)
SubObjectPropertyOf(Annotation(rdfs:comment "sub") ObjectInverseOf(:b) :e)
ObjectPropertyDomain(ObjectInverseOf(:c) ObjectSomeValuesFrom(:a :K))
DisjointObjectProperties(ObjectInverseOf(:e) ObjectInverseOf(:d) :c :a)
)
