Prefix(:=<http://example.org/in.owl#>)
Prefix(dc:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(prov:=<http://www.w3.org/ns/prov#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/in.owl>
<http://example.org/releases/1/in.owl>
Annotation(<http://purl.org/dc/terms/creator> "me")
Annotation(rdfs:comment "header")
Annotation(rdfs:seeAlso "from extra")

Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) Class(<http://example.org/A>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) Class(<http://example.org/B>))
Declaration(Class(<http://example.org/C>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) Class(<http://example.org/X>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) Class(owl:Thing))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) ObjectProperty(<http://example.org/op>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) DataProperty(<http://example.org/dp>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) NamedIndividual(<http://example.org/i>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) AnnotationProperty(dc:title))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/creator>))
Declaration(AnnotationProperty(prov:wasDerivedFrom))
############################
#   Annotation Properties
############################

# Annotation Property: dc:title (dc:title)

AnnotationAssertion(rdfs:isDefinedBy dc:title <http://example.org/in.owl>)

# Annotation Property: <http://purl.org/dc/terms/creator> (<http://purl.org/dc/terms/creator>)

AnnotationAssertion(rdfs:isDefinedBy <http://purl.org/dc/terms/creator> <http://example.org/in.owl>)

# Annotation Property: prov:wasDerivedFrom (prov:wasDerivedFrom)

AnnotationAssertion(rdfs:isDefinedBy prov:wasDerivedFrom <http://example.org/in.owl>)


############################
#   Object Properties
############################

# Object Property: <http://example.org/op> (<http://example.org/op>)

AnnotationAssertion(rdfs:isDefinedBy <http://example.org/op> <http://example.org/in.owl>)


############################
#   Data Properties
############################

# Data Property: <http://example.org/dp> (<http://example.org/dp>)

AnnotationAssertion(rdfs:isDefinedBy <http://example.org/dp> <http://example.org/in.owl>)



############################
#   Classes
############################

# Class: <http://example.org/A> (a)

AnnotationAssertion(rdfs:isDefinedBy <http://example.org/A> <http://example.org/in.owl>)
AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) rdfs:label <http://example.org/A> "a")
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/other>) <http://example.org/A> <http://example.org/B>)

# Class: <http://example.org/B> (<http://example.org/B>)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) rdfs:isDefinedBy <http://example.org/B> <http://example.org/elsewhere>)
SubClassOf(Annotation(rdfs:comment "c") Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) <http://example.org/B> owl:Thing)

# Class: <http://example.org/C> (<http://example.org/C>)

AnnotationAssertion(rdfs:isDefinedBy <http://example.org/C> <http://example.org/in.owl>)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) <http://example.org/C> <http://example.org/A>)

# Class: <http://example.org/X> (<http://example.org/X>)

AnnotationAssertion(rdfs:isDefinedBy <http://example.org/X> <http://example.org/in.owl>)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) <http://example.org/X> <http://example.org/A>)


############################
#   Named Individuals
############################

# Individual: <http://example.org/i> (<http://example.org/i>)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) dc:title <http://example.org/i> "eye")
AnnotationAssertion(rdfs:isDefinedBy <http://example.org/i> <http://example.org/in.owl>)
ClassAssertion(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) <http://example.org/A> <http://example.org/i>)
DataPropertyAssertion(Annotation(prov:wasDerivedFrom <http://example.org/releases/1/in.owl>) <http://example.org/dp> <http://example.org/i> "1"^^xsd:integer)


)