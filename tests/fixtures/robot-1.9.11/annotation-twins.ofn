Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(prov:=<http://www.w3.org/ns/prov#>)
Ontology(<http://example.org/twins>
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) Class(:A))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/s>) Class(:A))
Declaration(Class(:B))
Declaration(ObjectProperty(:r))
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) :A :B)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/s>) :A :B)
SubClassOf(Annotation(rdfs:comment "two") Annotation(prov:wasDerivedFrom <http://example.org/s>) :A ObjectSomeValuesFrom(:r :B))
SubClassOf(Annotation(rdfs:comment "one") :A ObjectSomeValuesFrom(:r :B))
SubClassOf(:A ObjectSomeValuesFrom(:r :B))
AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:label :A "a")
AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/s>) rdfs:label :A "a")
AnnotationAssertion(Annotation(rdfs:comment "z") rdfs:comment :A "c")
AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/s>) rdfs:comment :A "c")
ObjectPropertyDomain(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) :r :A)
ObjectPropertyDomain(Annotation(prov:wasDerivedFrom <http://example.org/s>) :r :A)
EquivalentClasses(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) :B ObjectSomeValuesFrom(:r :A))
EquivalentClasses(Annotation(prov:wasDerivedFrom <http://example.org/s>) :B ObjectSomeValuesFrom(:r :A))
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) ObjectSomeValuesFrom(:r :A) :B)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/s>) ObjectSomeValuesFrom(:r :A) :B)
DisjointClasses(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) :A :B ObjectSomeValuesFrom(:r :B))
DisjointClasses(Annotation(prov:wasDerivedFrom <http://example.org/s>) :A :B ObjectSomeValuesFrom(:r :B))
)
