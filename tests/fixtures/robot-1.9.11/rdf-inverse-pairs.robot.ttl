@prefix : <http://example.org/inv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/inv> .

<http://example.org/inv> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/inv#a_parent
:a_parent rdf:type owl:ObjectProperty ;
          owl:inverseOf :z_child .


###  http://example.org/inv#b_before
:b_before rdf:type owl:ObjectProperty ;
          owl:inverseOf :y_after .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :b_before ;
   owl:annotatedProperty owl:inverseOf ;
   owl:annotatedTarget :y_after ;
   rdfs:comment "stated by y_after"
 ] .


###  http://example.org/inv#has_part
:has_part rdf:type owl:ObjectProperty ;
          owl:inverseOf :part_of .


###  http://example.org/inv#part_of
:part_of rdf:type owl:ObjectProperty .


###  http://example.org/inv#y_after
:y_after rdf:type owl:ObjectProperty .


###  http://example.org/inv#z_child
:z_child rdf:type owl:ObjectProperty .


