Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(prov:=<http://www.w3.org/ns/prov#>)
Ontology(<http://example.org/p> <http://example.org/p/v1>
Import(<http://example.org/i>)
Annotation(rdfs:comment "p header")
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:X))
Declaration(Class(:Shared))
Declaration(AnnotationProperty(:ap))
SubClassOf(:A :B)
SubClassOf(Annotation(rdfs:comment "c") :B :X)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/orig>) :A :X)
SubClassOf(:Shared :B)
AnnotationAssertion(rdfs:label :A "A")
AnnotationAssertion(rdfs:isDefinedBy :B <http://example.org/elsewhere>)
AnnotationAssertion(:ap :A "v")
)
