Declaration(Class(:E))
Declaration(Class(:F))
Declaration(NamedIndividual(:s))
SubClassOf(:E <http://example.org/imp2#C>)
SubClassOf(Annotation(rdfs:comment "own") :E <http://example.org/imp2#D>)
