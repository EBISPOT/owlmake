@prefix : <http://example.org/connective-members#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/connective-members> .

<http://example.org/connective-members> rdf:type owl:Ontology .

#################################################################
#    Data properties
#################################################################

###  http://example.org/connective-members#d1
:d1 rdf:type owl:DatatypeProperty ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:unionOf rdf:nil
               ] .


###  http://example.org/connective-members#d2
:d2 rdf:type owl:DatatypeProperty ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:intersectionOf rdf:nil
               ] .


###  http://example.org/connective-members#d3
:d3 rdf:type owl:DatatypeProperty ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:oneOf rdf:nil
               ] .


###  http://example.org/connective-members#d4
:d4 rdf:type owl:DatatypeProperty ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:unionOf ( xsd:integer
                             )
               ] .


###  http://example.org/connective-members#d5
:d5 rdf:type owl:DatatypeProperty ;
    rdfs:range [ rdf:type rdfs:Datatype ;
                 owl:intersectionOf ( xsd:integer
                                      xsd:string
                                    )
               ] .


#################################################################
#    Classes
#################################################################

###  http://example.org/connective-members#B
:B rdf:type owl:Class .


###  http://example.org/connective-members#C
:C rdf:type owl:Class .


###  http://example.org/connective-members#EmptyI
:EmptyI rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf rdf:nil ;
                              rdf:type owl:Class
                            ] .


###  http://example.org/connective-members#EmptyO
:EmptyO rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Class ;
                              owl:oneOf rdf:nil
                            ] .


###  http://example.org/connective-members#EmptyU
:EmptyU rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Class ;
                              owl:unionOf rdf:nil
                            ] .


###  http://example.org/connective-members#OneI
:OneI rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :B
                                               ) ;
                            rdf:type owl:Class
                          ] .


###  http://example.org/connective-members#OneO
:OneO rdf:type owl:Class ;
      owl:equivalentClass [ rdf:type owl:Class ;
                            owl:oneOf ( :i
                                      )
                          ] .


###  http://example.org/connective-members#OneU
:OneU rdf:type owl:Class ;
      owl:equivalentClass [ rdf:type owl:Class ;
                            owl:unionOf ( :B
                                        )
                          ] .


###  http://example.org/connective-members#SubEmptyI
:SubEmptyI rdf:type owl:Class ;
           rdfs:subClassOf [ owl:intersectionOf rdf:nil ;
                             rdf:type owl:Class
                           ] .


###  http://example.org/connective-members#SubEmptyU
:SubEmptyU rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Class ;
                             owl:unionOf rdf:nil
                           ] .


###  http://example.org/connective-members#SubOneU
:SubOneU rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Class ;
                           owl:unionOf ( :C
                                       )
                         ] .


###  http://example.org/connective-members#TwoU
:TwoU rdf:type owl:Class ;
      owl:equivalentClass [ rdf:type owl:Class ;
                            owl:unionOf ( :B
                                          :C
                                        )
                          ] .


