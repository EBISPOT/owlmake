Prefix(:=<http://example.org/set-axioms-of-one#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/set-axioms-of-one>
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(DataProperty(:d))
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:V))
EquivalentObjectProperties(:p :p)
DisjointObjectProperties(:p :p)
DisjointObjectProperties(Annotation(rdfs:comment "inverse") ObjectInverseOf(:q) ObjectInverseOf(:q))
DisjointDataProperties(:d :d)
DisjointUnion(:V :B :B)
SubClassOf(Annotation(rdfs:comment "x") :A ObjectSomeValuesFrom(:p :B))
SubClassOf(Annotation(rdfs:comment "y") :B ObjectSomeValuesFrom(:q :A))
)
