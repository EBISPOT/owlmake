@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix EX: <http://purl.obolibrary.org/obo/EX_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .

<http://purl.obolibrary.org/obo/ex.owl> rdf:type owl:Ontology .

IAO:0000115 rdf:type owl:AnnotationProperty ;
    rdfs:label "definition" .

EX:0000001 rdf:type owl:Class ;
    rdfs:label "thing one" ;
    IAO:0000115 "The first example thing." .

EX:0000002 rdf:type owl:Class ;
    rdfs:label "thing two" ;
    IAO:0000115 "A kind of thing one." ;
    rdfs:subClassOf EX:0000001 .

EX:0000003 rdf:type owl:Class ;
    rdfs:label "thing three" ;
    rdfs:subClassOf EX:0000001 .
