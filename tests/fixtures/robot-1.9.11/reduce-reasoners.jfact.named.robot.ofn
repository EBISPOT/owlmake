############################
#   Object Properties
############################

# Object Property: :bq (:bq)

SubObjectPropertyOf(:bq :bp)

# Object Property: :bt (:bt)

TransitiveObjectProperty(:bt)

# Object Property: :df (:df)

FunctionalObjectProperty(:df)


############################
#   Classes
############################

# Class: :aA (:aA)

EquivalentClasses(:aA :aB)

# Class: :bC (:bC)

SubClassOf(:bC ObjectSomeValuesFrom(:bp :bD))
SubClassOf(:bC ObjectSomeValuesFrom(:bp :bE))
SubClassOf(:bC ObjectSomeValuesFrom(:bq :bN))

# Class: :bD (:bD)

SubClassOf(:bD ObjectSomeValuesFrom(:bt :bE))

# Class: :bM (:bM)

SubClassOf(:bM ObjectSomeValuesFrom(:bq :bN))

# Class: :bN (:bN)

SubClassOf(:bN ObjectSomeValuesFrom(:bt :bD))
SubClassOf(:bN ObjectSomeValuesFrom(:bt :bE))

# Class: :bS (:bS)

SubClassOf(:bS ObjectSomeValuesFrom(:bp :bD))
SubClassOf(:bS ObjectSomeValuesFrom(:bq :bD))

# Class: :bT (:bT)

SubClassOf(:bT ObjectSomeValuesFrom(:bp :bE))

# Class: :dC (:dC)

SubClassOf(:dC ObjectUnionOf(:dA :dB))

# Class: :dF (:dF)

SubClassOf(:dF ObjectSomeValuesFrom(:df :dA))
SubClassOf(:dF ObjectSomeValuesFrom(:df :dD))
SubClassOf(:dF ObjectSomeValuesFrom(:df ObjectIntersectionOf(:dA :dD)))
SubClassOf(:dF ObjectAllValuesFrom(:dp :dD))
SubClassOf(:dF ObjectAllValuesFrom(:dp :dE))

# Class: :eW (:eW)

SubClassOf(:eW :eU)

# Class: :gA (:gA)

EquivalentClasses(:gA :gB)

# Class: :gE (:gE)

EquivalentClasses(:gE ObjectIntersectionOf(:gG ObjectSomeValuesFrom(:gp :gH)))


SubClassOf(ObjectIntersectionOf(:cA :cB) :cX)
SubClassOf(ObjectIntersectionOf(:cA :cB) :cZ)
SubClassOf(ObjectIntersectionOf(:eA :eB) owl:Nothing)
SubClassOf(ObjectSomeValuesFrom(:cp :cA) :cY)
SubClassOf(ObjectSomeValuesFrom(:cp :cA) :cZ)
