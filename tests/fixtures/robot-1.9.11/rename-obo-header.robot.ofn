Prefix(:=<http://purl.obolibrary.org/obo/h.owl#>)
Prefix(dc:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)


Ontology(<http://purl.obolibrary.org/obo/h.owl>
Annotation(Annotation(oboInOwl:hasDbXref "PMID:1") <http://purl.obolibrary.org/obo/IAO_0000115> "a def")
Annotation(Annotation(rdfs:comment "by whom") dc:creator "me")
Annotation(dcterms:date "2024-01-01"^^xsd:date)
Annotation(oboInOwl:default-namespace "dn")
Annotation(oboInOwl:hasDbXref "DB:1")
Annotation(Annotation(rdfs:label "xl") oboInOwl:hasDbXref "DB:2")
Annotation(oboInOwl:hasExactSynonym "hsyn")
Annotation(oboInOwl:hasOBONamespace "ns")
Annotation(oboInOwl:is_metadata_tag "true"^^xsd:boolean)
Annotation(oboInOwl:logical-definition-view-relation "part_of")
Annotation(oboInOwl:treat-xrefs-as-has-subclass "X")
Annotation(oboInOwl:treat-xrefs-as-reverse-genus-differentia "Y part_of Z")
Annotation(Annotation(rdfs:comment "q") rdfs:comment "c1")
Annotation(rdfs:comment "say \"hi\" {x}")
Annotation(rdfs:label "H label")
Annotation(rdfs:seeAlso <http://example.org/x>)
Annotation(rdfs:seeAlso _:genid2147483648)

Declaration(Class(<http://example.org/h#A2>))
Declaration(Class(<http://example.org/h#B>))
Declaration(Class(<http://example.org/h#C>))
Declaration(AnnotationProperty(<http://purl.obolibrary.org/obo/IAO_0000115>))
Declaration(AnnotationProperty(dc:creator))
Declaration(AnnotationProperty(dcterms:date))
Declaration(AnnotationProperty(oboInOwl:default-namespace))
Declaration(AnnotationProperty(oboInOwl:hasDbXref))
Declaration(AnnotationProperty(oboInOwl:hasExactSynonym))
Declaration(AnnotationProperty(oboInOwl:hasOBONamespace))
Declaration(AnnotationProperty(oboInOwl:is_metadata_tag))
Declaration(AnnotationProperty(oboInOwl:logical-definition-view-relation))
Declaration(AnnotationProperty(oboInOwl:treat-xrefs-as-has-subclass))
Declaration(AnnotationProperty(oboInOwl:treat-xrefs-as-reverse-genus-differentia))
Declaration(Datatype(<http://example.org/dt>))
Declaration(Datatype(xsd:date))


############################
#   Classes
############################

# Class: <http://example.org/h#A2> (A)

AnnotationAssertion(dcterms:date <http://example.org/h#A2> "2024-01-01"^^xsd:date)
AnnotationAssertion(rdfs:label <http://example.org/h#A2> "A")
AnnotationAssertion(rdfs:seeAlso <http://example.org/h#A2> "lit"^^<http://example.org/dt>)
AnnotationAssertion(rdfs:seeAlso <http://example.org/h#A2> "xl"^^rdf:XMLLiteral)
DisjointUnion(<http://example.org/h#A2> <http://example.org/h#B> <http://example.org/h#C>)

# Class: <http://example.org/h#B> (<http://example.org/h#B>)

AnnotationAssertion(rdfs:seeAlso <http://example.org/h#B> _:genid2147483648)

# Class: <http://example.org/h#C> (<http://example.org/h#C>)

AnnotationAssertion(rdfs:comment <http://example.org/h#C> "  ")


)