Prefix(:=<http://example.org/>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://example.org/frame-distinct-values.owl>
Declaration(ObjectProperty(<http://example.org/p>))
Declaration(DataProperty(<http://example.org/d>))
ObjectPropertyDomain(<http://example.org/p> DataHasValue(<http://example.org/d> "1"))
ObjectPropertyDomain(<http://example.org/p> DataHasValue(<http://example.org/d> "1"^^xsd:integer))
ObjectPropertyRange(<http://example.org/p> ObjectOneOf(<http://example.org/a>))
ObjectPropertyRange(<http://example.org/p> ObjectOneOf(<http://example.org/b>))
)
