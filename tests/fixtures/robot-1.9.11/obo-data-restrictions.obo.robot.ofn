Prefix(:=<http://purl.obolibrary.org/obo/t.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://purl.obolibrary.org/obo/t.owl>
Annotation(<http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> "1.2")

Declaration(Class(<http://purl.obolibrary.org/obo/T_1>))
Declaration(Class(<http://purl.obolibrary.org/obo/T_2>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/T_10>))
Declaration(DataProperty(<http://purl.obolibrary.org/obo/T_20>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#id>))
############################
#   Annotation Properties
############################

# Annotation Property: <http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> (has_obo_format_version)

AnnotationAssertion(rdfs:label <http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> "has_obo_format_version")

# Annotation Property: <http://www.geneontology.org/formats/oboInOwl#id> (id)

AnnotationAssertion(rdfs:label <http://www.geneontology.org/formats/oboInOwl#id> "id")





############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/T_1> (<http://purl.obolibrary.org/obo/T_1>)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/T_1> "T:1")
EquivalentClasses(<http://purl.obolibrary.org/obo/T_1> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/T_2> DataSomeValuesFrom(<http://purl.obolibrary.org/obo/T_20> xsd:string)))
SubClassOf(<http://purl.obolibrary.org/obo/T_1> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/T_2> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/T_10> <http://purl.obolibrary.org/obo/T_2>) DataMinCardinality(1 <http://purl.obolibrary.org/obo/T_20> xsd:integer)))

# Class: <http://purl.obolibrary.org/obo/T_2> (<http://purl.obolibrary.org/obo/T_2>)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/T_2> "T:2")
SubClassOf(<http://purl.obolibrary.org/obo/T_2> DataAllValuesFrom(<http://purl.obolibrary.org/obo/T_20> DataOneOf("a" "b")))
SubClassOf(<http://purl.obolibrary.org/obo/T_2> DataHasValue(<http://purl.obolibrary.org/obo/T_20> "x"))


)