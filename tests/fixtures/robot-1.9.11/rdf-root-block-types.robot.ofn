############################
#   Object Properties
############################

# Object Property: :s (:s)

EquivalentObjectProperties(:s :t :u)


############################
#   Data Properties
############################

# Data Property: :p (:p)

EquivalentDataProperties(:p :q :r)


############################
#   Classes
############################

# Class: :A (:A)

EquivalentClasses(:A :B :C)

# Class: :D (:D)

EquivalentClasses(:D :E :F)


############################
#   Named Individuals
############################

# Individual: :a (:a)

SameIndividual(:a :b)

# Individual: :c (:c)

SameIndividual(:c :d)

# Individual: :x (:x)

SameIndividual(:x :y :z)


