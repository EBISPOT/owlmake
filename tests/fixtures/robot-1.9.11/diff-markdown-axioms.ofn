Prefix(:=<http://example.org/m2#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(swrlb:=<http://www.w3.org/2003/11/swrlb#>)
Ontology(<http://example.org/m2>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(DataProperty(:d))
Declaration(DataProperty(:e))
Declaration(DataProperty(:f))
Declaration(AnnotationProperty(:ap))
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(:j))
Declaration(NamedIndividual(:k))
AnnotationAssertion(rdfs:label :ap "an ap")
AnnotationAssertion(rdfs:label <http://example.org/m2/doc> "the doc")
AnnotationAssertion(:ap <http://example.org/m2/doc> _:v)
AnnotationAssertion(:ap :A _:v)
AnnotationPropertyDomain(:ap <http://example.org/m2/doc>)
EquivalentDataProperties(:d :e)
EquivalentDataProperties(:d :e :f)
DisjointDataProperties(:d :e)
DisjointDataProperties(:d :e :f)
DisjointObjectProperties(:p :q :r)
EquivalentObjectProperties(:p :q :r)
SymmetricObjectProperty(:p)
AsymmetricObjectProperty(:q)
ReflexiveObjectProperty(:r)
IrreflexiveObjectProperty(ObjectInverseOf(:r))
InverseFunctionalObjectProperty(:p)
EquivalentClasses(:A :B :C)
EquivalentClasses(:A ObjectUnionOf(:B ObjectIntersectionOf(:C ObjectComplementOf(:A))))
DifferentIndividuals(:i :j :k)
SubObjectPropertyOf(ObjectInverseOf(:q) ObjectInverseOf(:r))
SubClassOf(:A DataMinCardinality(2 :d xsd:string))
SubClassOf(:A ObjectExactCardinality(1 :p ObjectUnionOf(:B :C)))
SubClassOf(:A ObjectComplementOf(ObjectSomeValuesFrom(:p :B)))
SubClassOf(:A ObjectAllValuesFrom(ObjectInverseOf(:p) ObjectComplementOf(:B)))
SubClassOf(:B DataAllValuesFrom(:d DataComplementOf(DataUnionOf(xsd:integer xsd:boolean))))
SubClassOf(:B DataSomeValuesFrom(:d DataOneOf("x"@en "1.0"^^xsd:decimal "1.0e1"^^xsd:double)))
SubClassOf(:B ObjectHasValue(ObjectInverseOf(:p) :i))
SubClassOf(:C ObjectOneOf(:k :i :j))
HasKey(:B () (:e :d))
HasKey(:C (:q :p) ())
ObjectPropertyAssertion(ObjectInverseOf(:p) :i :j)
DLSafeRule(Body() Head(ClassAtom(:A Variable(<urn:swrl:var#x>))))
DLSafeRule(Body(DataRangeAtom(DataUnionOf(xsd:integer xsd:string) Variable(<urn:swrl:var#y>)) BuiltInAtom(swrlb:add Variable(<urn:swrl:var#y>) "1"^^xsd:integer "2"^^xsd:integer)) Head(DataPropertyAtom(:d Variable(<urn:swrl:var#z>) Variable(<urn:swrl:var#y>))))
)
