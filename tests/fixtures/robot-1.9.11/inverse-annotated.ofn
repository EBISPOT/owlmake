Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/inverse-annotated.owl>
Declaration(ObjectProperty(:p))
Declaration(NamedIndividual(:b))
Declaration(NamedIndividual(:s))
Declaration(Class(:K))
ObjectPropertyAssertion(Annotation(rdfs:comment "one") ObjectInverseOf(:p) _:a :b)
ObjectPropertyAssertion(Annotation(rdfs:comment "two") ObjectInverseOf(:p) :s _:x)
ObjectPropertyAssertion(Annotation(rdfs:comment "three") ObjectInverseOf(:p) _:y _:z)
ClassAssertion(:K _:a)
ClassAssertion(:K _:x)
ClassAssertion(:K _:y)
)
