@prefix : <http://example.org/g#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/g> .

<http://example.org/g> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/g#p
:p rdf:type owl:ObjectProperty .


###  http://example.org/g#q
:q rdf:type owl:ObjectProperty .


###  http://example.org/g#r
:r rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/g#A
:A rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :p ;
                        owl:someValuesFrom [ rdf:type owl:Restriction ;
                                             owl:onProperty :q ;
                                             owl:someValuesFrom :A
                                           ] ;
                        owl:equivalentClass _:genid3
                      ] ;
  owl:annotatedProperty owl:equivalentClass ;
  owl:annotatedTarget _:genid3 ;
  rdfs:comment "anonymous pair"
] .

_:genid3 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :A .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :p ;
                        owl:someValuesFrom :A ;
                        rdfs:subClassOf _:genid6
                      ] ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget _:genid6 ;
  rdfs:comment "gci"
] .

_:genid6 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :A .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :p ;
                        owl:someValuesFrom :A ;
                        rdfs:subClassOf _:genid9
                      ] ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget _:genid9 ;
  rdfs:comment "gci with another comment"
] .

_:genid9 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :A .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :p ;
                        owl:someValuesFrom :A ;
                        rdfs:subClassOf _:genid12
                      ] ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget _:genid12 ;
  rdfs:comment "universal"
] .

_:genid12 rdf:type owl:Restriction ;
           owl:onProperty :q ;
           owl:allValuesFrom :A .


[ rdf:type owl:Restriction ;
  owl:onProperty :r ;
  owl:someValuesFrom :A ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty :q ;
                    owl:someValuesFrom :A
                  ]
] .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :q ;
                        owl:someValuesFrom :A ;
                        owl:disjointWith _:genid17
                      ] ;
  owl:annotatedProperty owl:disjointWith ;
  owl:annotatedTarget _:genid17 ;
  rdfs:comment "disjoint pair"
] .

_:genid17 rdf:type owl:Restriction ;
           owl:onProperty :r ;
           owl:someValuesFrom :A .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :q ;
                        owl:someValuesFrom :A ;
                        owl:disjointWith _:genid20
                      ] ;
  owl:annotatedProperty owl:disjointWith ;
  owl:annotatedTarget _:genid20 ;
  rdfs:comment "disjoint pair again"
] .

_:genid20 rdf:type owl:Restriction ;
           owl:onProperty :r ;
           owl:someValuesFrom :A .


