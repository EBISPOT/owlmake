@prefix : <http://example.org/anon#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/anon> .

<http://example.org/anon> rdf:type owl:Ontology ;
                           :note [ rdf:type :A ;
                                   :d "header"
                                 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/anon#note
:note rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/anon#p
:p rdf:type owl:ObjectProperty .


###  http://example.org/anon#q
:q rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.org/anon#d
:d rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/anon#A
:A rdf:type owl:Class ;
   :note [ rdfs:label "note"
         ] .


###  http://example.org/anon#B
:B rdf:type owl:Class ;
   :note _:genid3 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :B ;
   owl:annotatedProperty :note ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "on"
 ] .


###  http://example.org/anon#C
:C rdf:type owl:Class ;
   rdfs:subClassOf :D .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :C ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget :D ;
   :note _:genid6
 ] .

_:genid6 rdf:type :A .


###  http://example.org/anon#D
:D rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/anon#i
:i rdf:type owl:NamedIndividual ;
   :p _:genid7 ;
   :q _:genid9 .

_:genid7 :q [ rdf:type :D
             ] .

_:genid9 :d 3 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :i ;
   owl:annotatedProperty :q ;
   owl:annotatedTarget _:genid9 ;
   rdfs:comment "annotated"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource _:genid9 ;
   owl:annotatedProperty :d ;
   owl:annotatedTarget 3 ;
   rdfs:comment "pulled"
 ] .


###  http://example.org/anon#j
:j rdf:type owl:NamedIndividual ;
   :q [ rdf:type :A
      ] .


###  http://example.org/anon#k
:k rdf:type owl:NamedIndividual ;
   owl:differentFrom _:genid13 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :k ;
   owl:annotatedProperty owl:differentFrom ;
   owl:annotatedTarget _:genid13 ;
   rdfs:comment "apart"
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual :k ;
   owl:assertionProperty :d ;
   owl:targetValue "5"
 ] .


[ rdf:type :A ,
           owl:Thing
] .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
   owl:onProperty :q ;
   owl:hasValue _:genid18 ;
   rdfs:subClassOf :D
 ] .

_:genid18 rdf:type :C .

[ rdf:type owl:Axiom ;
   owl:annotatedSource _:genid18 ;
   owl:annotatedProperty rdf:type ;
   owl:annotatedTarget :C ;
   rdfs:comment "general"
 ] .


