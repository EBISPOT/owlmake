    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/i -->

    <owl:NamedIndividual rdf:about="http://example.org/i">
        <example:d rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01Z</example:d>
        <example:d rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.50</example:d>
        <example:d rdf:datatype="http://www.w3.org/2001/XMLSchema#int">+5</example:d>
        <example:d rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">007</example:d>
        <example:d rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</example:d>
    </owl:NamedIndividual>
</rdf:RDF>



