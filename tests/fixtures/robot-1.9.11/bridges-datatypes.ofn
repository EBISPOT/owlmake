Prefix(:=<http://example.org/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://example.org/bridge2.owl>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:p))
Declaration(DataProperty(:d))
Declaration(DataProperty(:e))
Declaration(NamedIndividual(:y))
SubClassOf(:C :B)
SubClassOf(:B :A)
DataPropertyRange(:e xsd:decimal)
SubClassOf(:B DataHasValue(:d "5"^^xsd:integer))
SubClassOf(:B DataSomeValuesFrom(:d DataOneOf("a")))
SubClassOf(:B DataSomeValuesFrom(:d DatatypeRestriction(xsd:integer xsd:minInclusive "1"^^xsd:integer)))
SubClassOf(:B DataSomeValuesFrom(:d xsd:decimal))
SubClassOf(:B ObjectMinCardinality(1 :p))
SubClassOf(:B ObjectSomeValuesFrom(:p owl:Thing))
SubClassOf(:B ObjectSomeValuesFrom(ObjectInverseOf(:p) :A))
)
