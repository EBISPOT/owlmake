Prefix(:=<http://example.org/class-assertions-top#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/class-assertions-top>

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:T))
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(:j))
############################
#   Classes
############################

# Class: :A (:A)

SubClassOf(:A :B)

# Class: :T (:T)

EquivalentClasses(:T owl:Thing)


############################
#   Named Individuals
############################

# Individual: :i (:i)

ClassAssertion(owl:Thing :i)

# Individual: :j (:j)

ClassAssertion(:A :j)


)