@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology ;
   owl:imports <http://example.org/ontology-headers/one.owl> ,
               <http://example.org/ontology-headers/two.owl> ;
   rdfs:comment "a header with an IRI" ,
                "a header with no IRI" ;
   rdfs:label "first"@en
 ] .

