Declaration(NamedIndividual(:bob))
Declaration(NamedIndividual(:cat))
Declaration(NamedIndividual(:dan))
EquivalentClasses(Annotation(rdfs:comment "named") :A :B :C)
EquivalentClasses(Annotation(rdfs:comment "mixed") :D :E ObjectSomeValuesFrom(:p :F) ObjectAllValuesFrom(:q :G))
EquivalentClasses(:F ObjectSomeValuesFrom(:r :A) ObjectSomeValuesFrom(:s :B))
EquivalentClasses(Annotation(rdfs:comment "general") ObjectSomeValuesFrom(:p :A) ObjectSomeValuesFrom(:q :B) ObjectSomeValuesFrom(:r :C))
SubClassOf(Annotation(rdfs:comment "sub") :A ObjectSomeValuesFrom(:t :G))
EquivalentObjectProperties(Annotation(rdfs:comment "inverse") :q :r ObjectInverseOf(:s))
EquivalentObjectProperties(:t ObjectInverseOf(:q) ObjectInverseOf(:r))
EquivalentObjectProperties(Annotation(rdfs:comment "inverse first") :s :t ObjectInverseOf(:p))
EquivalentDataProperties(Annotation(rdfs:comment "data") :d :e :f :g)
SameIndividual(Annotation(rdfs:comment "same") :amy :bob :cat :dan)
)
