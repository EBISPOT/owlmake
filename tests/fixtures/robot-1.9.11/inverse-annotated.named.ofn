Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/inverse-annotated.owl>
Declaration(ObjectProperty(:p))
Declaration(NamedIndividual(:b))
Declaration(NamedIndividual(:s))
Declaration(Class(:K))
ObjectPropertyAssertion(Annotation(rdfs:comment "one") :p :b _:a)
ObjectPropertyAssertion(Annotation(rdfs:comment "two") :p _:x :s)
ObjectPropertyAssertion(Annotation(rdfs:comment "three") :p _:z _:y)
ClassAssertion(:K _:a)
ClassAssertion(:K _:x)
ClassAssertion(:K _:y)
)
