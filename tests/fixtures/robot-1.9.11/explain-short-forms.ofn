Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/explain-short-forms.owl>
Declaration(Class(<http://example.org/a#1>))
Declaration(Class(<http://example.org/b/>))
Declaration(Class(<http://example.org/d#>))
Declaration(Class(<urn:x:e>))
Declaration(Class(<http://example.org/f>))
AnnotationAssertion(rdfs:label <http://example.org/f> "eff")
SubClassOf(<http://example.org/a#1> <http://example.org/b/>)
SubClassOf(<http://example.org/b/> <urn:x:e>)
SubClassOf(<urn:x:e> <http://example.org/d#>)
SubClassOf(<http://example.org/d#> <http://example.org/f>)
)
