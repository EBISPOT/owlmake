        <owl:propertyDisjointWith rdf:resource="http://example.org/b#q"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/b#q -->

    <owl:ObjectProperty rdf:about="http://example.org/b#q"/>
    


