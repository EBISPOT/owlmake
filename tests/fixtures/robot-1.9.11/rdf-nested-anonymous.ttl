@base <http://example.org/nest> .

<http://example.org/nest> rdf:type owl:Ontology ;
                           nest:see _:genid1 ;
                           rdfs:comment "header" .

_:genid1 rdf:type nest:B .

[ rdf:type owl:Annotation ;
   owl:annotatedSource <http://example.org/nest> ;
   owl:annotatedProperty nest:see ;
   owl:annotatedTarget _:genid1 ;
   rdfs:comment "header value"
 ] .

[ rdf:type owl:Annotation ;
   owl:annotatedSource <http://example.org/nest> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "header" ;
   nest:see [ rdf:type nest:A
            ]
 ] .

