<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/reified-anonymous#"
     xml:base="http://example.org/reified-anonymous"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/reified-anonymous"/>
    <owl:Class rdf:about="http://example.org/reified-anonymous#C"/>
    <owl:ObjectProperty rdf:about="http://example.org/reified-anonymous#p"/>
    <owl:NamedIndividual rdf:about="http://example.org/reified-anonymous#i"/>
    <rdf:Description rdf:nodeID="different"/>
    <rdf:Description rdf:nodeID="labelled">
        <rdfs:label>labelled</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/reified-anonymous#i"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#differentFrom"/>
        <owl:annotatedTarget rdf:nodeID="different"/>
        <rdfs:comment>different</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/reified-anonymous#i"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#sameAs"/>
        <owl:annotatedTarget rdf:nodeID="same"/>
        <rdfs:comment>same</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/reified-anonymous#i"/>
        <owl:annotatedProperty rdf:resource="http://example.org/reified-anonymous#p"/>
        <owl:annotatedTarget rdf:nodeID="related"/>
        <rdfs:comment>related</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:nodeID="labelled"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://example.org/reified-anonymous#C"/>
        <rdfs:comment>typed with a label</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:nodeID="bare"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:resource="http://example.org/reified-anonymous#C"/>
        <rdfs:comment>typed alone</rdfs:comment>
    </owl:Axiom>
</rdf:RDF>
