        <oboInOwl:hasDbXref>Wikipedia:Thing</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>foo:xyz</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>T1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>previous</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>thingo</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>example</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>things one</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>EX:0000001</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/ex#core"/>
        <rdfs:comment>A comment.</rdfs:comment>
        <rdfs:label>thing one</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EX_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>previous</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/ex#OLD"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EX_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>things one</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/ex#PLURAL"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EX_0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The first example thing.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>foo:abc</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EX_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>the one</owl:annotatedTarget>
        <oboInOwl:hasDbXref>foo:x</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EX_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>Wikipedia:Thing</owl:annotatedTarget>
        <rdfs:label>a description</rdfs:label>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EX_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>foo:xyz</owl:annotatedTarget>
        <rdfs:comment>hello</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EX_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>T1</owl:annotatedTarget>
