Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<http://example.org/nest>
Annotation(Annotation(:see _:h1) rdfs:comment "header")
Annotation(Annotation(rdfs:comment "header value") :see _:h2)

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(Class(:D))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(DataProperty(:d))
Declaration(AnnotationProperty(:see))
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(:j))
Declaration(NamedIndividual(:k))
Declaration(NamedIndividual(:m))

ClassAssertion(:A _:h1)
ClassAssertion(:B _:h2)

ObjectPropertyAssertion(Annotation(Annotation(:see _:a1) rdfs:comment "assertion") :p :j :i)
ClassAssertion(:A _:a1)
DataPropertyAssertion(Annotation(Annotation(rdfs:comment "data value") :see _:a2) :d :j "1")
DataPropertyAssertion(:d _:a2 "2")
ObjectPropertyAssertion(:q _:a2 :k)
SubClassOf(Annotation(Annotation(rdfs:comment "subclass value") :see _:a3) :A :B)
ClassAssertion(:C _:a3)
ObjectPropertyAssertion(:q :k _:a3)
AnnotationAssertion(Annotation(Annotation(Annotation(:see _:a4) rdfs:comment "nn") rdfs:comment "label") rdfs:label :A "a")
SubClassOf(Annotation(Annotation(rdfs:comment "gci value") :see _:a5) ObjectSomeValuesFrom(:p :A) :B)
ClassAssertion(:D _:a5)
DisjointClasses(Annotation(Annotation(:see _:a6) rdfs:comment "disjoint") :A :C :D)
DifferentIndividuals(Annotation(Annotation(rdfs:comment "different value") :see _:a7) :i :j :k)
NegativeObjectPropertyAssertion(Annotation(Annotation(:see _:a8) rdfs:comment "negative") :p :j :k)
ClassAssertion(:A _:a8)
EquivalentClasses(Annotation(Annotation(rdfs:comment "equivalent value") :see _:a9) :B :C :D)
SubObjectPropertyOf(Annotation(Annotation(Annotation(:see _:a10) rdfs:comment "nn") rdfs:comment "subproperty") :p :q)
ClassAssertion(Annotation(Annotation(rdfs:comment "type value") :see _:a11) :A :m)
ObjectPropertyAssertion(:r :m _:a11)
DLSafeRule(Annotation(Annotation(rdfs:comment "rule value") :see _:a12) Body(ClassAtom(:A Variable(<urn:swrl:var#x>))) Head(ClassAtom(:B Variable(<urn:swrl:var#x>))))
)
