@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix EX: <http://purl.obolibrary.org/obo/EX_> .
@prefix foo: <http://example.org/foo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://purl.obolibrary.org/obo/ex.owl> rdf:type owl:Ontology ;
    dc:title "t" ;
    rdfs:seeAlso <http://purl.org/dc/terms/x> .
EX:0000001 rdf:type owl:Class ; rdfs:label "one" ;
    rdfs:seeAlso <http://example.org/baz/x> ;
    oboInOwl:hasDbXref "baz:1" .
foo:A rdf:type owl:Class ; rdfs:label "a" ; rdfs:subClassOf EX:0000001 .
<http://example.org/baz/B> rdf:type owl:Class ; rdfs:label "b" ; rdfs:subClassOf foo:A .
<http://example.org/baz/p> rdf:type owl:AnnotationProperty .
EX:0000001 <http://example.org/baz/p> "v" .
