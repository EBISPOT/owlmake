@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a owl:Ontology .
<#p> a owl:ObjectProperty .
<#A> a owl:Class ;
    rdfs:subClassOf <#B> ;
    rdfs:seeAlso <other.owl#C> .
<#B> a owl:Class .
<#i> a owl:NamedIndividual , <#A> ;
    <#p> <#j> .
