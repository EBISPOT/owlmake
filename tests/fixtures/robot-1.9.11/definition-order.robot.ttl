@prefix : <http://example.org/definition-order.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/definition-order.owl> .

<http://example.org/definition-order.owl> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/definition-order.owl#q
:q rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/definition-order.owl#A
:A rdf:type owl:Class ;
   owl:equivalentClass _:genid1 ;
   rdfs:subClassOf _:genid5 .

_:genid1 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :B ;
          owl:equivalentClass _:genid3 .

_:genid5 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :C .

_:genid3 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :C .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid1 ;
   rdfs:comment "c"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource _:genid1 ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "c"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid5 ;
   rdfs:comment "s"
 ] .


###  http://example.org/definition-order.owl#B
:B rdf:type owl:Class .


###  http://example.org/definition-order.owl#C
:C rdf:type owl:Class .


