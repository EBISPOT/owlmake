Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(
Declaration(Class(<http://example.org/text#X>))


############################
#   Classes
############################

# Class: <http://example.org/text#X> (b)

AnnotationAssertion(rdfs:comment <http://example.org/text#X> "d"@en)
AnnotationAssertion(rdfs:comment <http://example.org/text#X> "c")
AnnotationAssertion(rdfs:label <http://example.org/text#X> "b"@en)
AnnotationAssertion(rdfs:label <http://example.org/text#X> "a")


)