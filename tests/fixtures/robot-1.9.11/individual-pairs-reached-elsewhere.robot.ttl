@prefix : <http://example.org/pairs#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/pairs> .

<http://example.org/pairs> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/pairs#ap0
:ap0 rdf:type owl:AnnotationProperty ;
     rdfs:comment _:genid1 .


###  http://example.org/pairs#i1
:i1 owl:sameAs :i3 .


###  http://example.org/pairs#i3
:i3 owl:sameAs _:genid1 .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/pairs#op0
:op0 rdf:type owl:ObjectProperty ;
     rdfs:range _:genid2 .

_:genid2 rdf:type owl:Restriction ;
          owl:onProperty :op0 ;
          owl:hasValue _:genid3 .

_:genid3 :op1 _:genid5 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :i5 ;
   owl:annotatedProperty owl:differentFrom ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "annotated difference"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :op0 ;
   owl:annotatedProperty rdfs:range ;
   owl:annotatedTarget _:genid2 ;
   rdfs:comment "annotated range"
 ] .


###  http://example.org/pairs#i4
:i4 owl:sameAs _:genid3 ;
    owl:differentFrom _:genid3 ,
                      _:genid5 ;
    :op1 _:genid3 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :i5 ;
   owl:annotatedProperty owl:differentFrom ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "annotated difference"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :op0 ;
   owl:annotatedProperty rdfs:range ;
   owl:annotatedTarget _:genid2 ;
   rdfs:comment "annotated range"
 ] .


###  http://example.org/pairs#op1
:op1 rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/pairs#A
:A rdf:type owl:Class ;
   owl:equivalentClass :B1 ;
   rdfs:subClassOf [ rdf:type owl:Restriction ;
                     owl:onProperty :op1 ;
                     owl:hasValue _:genid8
                   ] .


###  http://example.org/pairs#B1
:B1 owl:equivalentClass :B2 .


###  http://example.org/pairs#B2

###  http://example.org/pairs#A0
:A0 owl:sameAs _:genid8 .


###  http://example.org/pairs#B1
:B1 rdf:type owl:Class .


###  http://example.org/pairs#B2
:B2 rdf:type owl:Class .


###  http://example.org/pairs#C
:C rdf:type owl:Class ;
   rdfs:subClassOf [ rdf:type owl:Restriction ;
                     owl:onProperty :op1 ;
                     owl:hasValue _:genid10
                   ] .

[ rdf:type owl:AllDifferent ;
   owl:distinctMembers ( :i2
                         _:genid10
                         [ rdf:type :C
                         ]
                       )
 ] .


###  http://example.org/pairs#i2
[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :i2
                        _:genid10
                        [ rdf:type :C
                        ]
                      )
] .


