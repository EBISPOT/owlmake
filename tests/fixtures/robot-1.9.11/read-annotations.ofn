Declaration(NamedIndividual(:j))
Declaration(NamedIndividual(:k))
ObjectPropertyAssertion(Annotation(Annotation(Annotation(rdfs:comment "three") rdfs:comment "two") rdfs:comment "one") :q :i :j)
NegativeObjectPropertyAssertion(Annotation(Annotation(rdfs:comment "negative two") rdfs:comment "negative one") :p :i :k)
