Annotation(Annotation(Annotation(rdfs:comment "ontology three") rdfs:comment "ontology two") rdfs:comment "ontology one")
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(DataProperty(:d))
Declaration(DataProperty(:e))
Declaration(DataProperty(:f))
