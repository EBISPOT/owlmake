Prefix(:=<http://example.org/prefix-names#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(part:=<http://purl.obolibrary.org/obo/BFO_0000050>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(organ:=<http://purl.obolibrary.org/obo/UBERON_0000062>)
Prefix(idsfor:=<http://purl.obolibrary.org/obo/IAO_0000598>)
Prefix(idrange:=<http://purl.obolibrary.org/obo/ro/idrange/>)
Prefix(allocatedto:=<http://purl.obolibrary.org/obo/IAO_0000597>)


Ontology(<http://example.org/prefix-names>
Annotation(<http://purl.obolibrary.org/obo/IAO_0000598> "PN")

Declaration(Class(<http://purl.obolibrary.org/obo/UBERON_0000062>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000050>))
Declaration(NamedIndividual(:body))
Declaration(NamedIndividual(:heart))
Declaration(AnnotationProperty(<http://purl.obolibrary.org/obo/IAO_0000597>))
Declaration(AnnotationProperty(<http://purl.obolibrary.org/obo/IAO_0000598>))
Declaration(Datatype(<http://purl.obolibrary.org/obo/ro/idrange/1>))


############################
#   Datatypes
############################

# Datatype: <http://purl.obolibrary.org/obo/ro/idrange/1> (<http://purl.obolibrary.org/obo/ro/idrange/1>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000597> <http://purl.obolibrary.org/obo/ro/idrange/1> "ONTOLOGY-CREATOR")
DatatypeDefinition(<http://purl.obolibrary.org/obo/ro/idrange/1> DatatypeRestriction(xsd:integer xsd:minInclusive "0"^^xsd:integer xsd:maxInclusive "999999"^^xsd:integer))


############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/UBERON_0000062> (organ)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0000062> "organ")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0000062> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000062>))


############################
#   Named Individuals
############################

# Individual: :heart (:heart)

ClassAssertion(<http://purl.obolibrary.org/obo/UBERON_0000062> :heart)
ObjectPropertyAssertion(<http://purl.obolibrary.org/obo/BFO_0000050> :heart :body)


)