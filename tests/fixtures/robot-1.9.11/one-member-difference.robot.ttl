@prefix : <http://example.org/one-member-difference.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/one-member-difference.owl> .

<http://example.org/one-member-difference.owl> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/one-member-difference.owl#p
:p rdf:type owl:ObjectProperty .


###  http://example.org/one-member-difference.owl#q
:q rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/one-member-difference.owl#C
:C rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/one-member-difference.owl#i
:i rdf:type owl:NamedIndividual ;
   :p _:genid1 ;
   :q _:genid6 .

[ rdf:type owl:AllDifferent ;
   owl:distinctMembers ( _:genid1
                       )
 ] .

[ rdf:type owl:AllDifferent ;
   owl:distinctMembers ( _:genid1
                       ) ;
   rdfs:comment "d"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :i ;
   owl:annotatedProperty :q ;
   owl:annotatedTarget _:genid6 ;
   rdfs:comment "a"
 ] .


###  http://example.org/one-member-difference.owl#j
:j rdf:type owl:NamedIndividual ;
   :q _:genid6 .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :p ;
                        owl:someValuesFrom :C ;
                        rdfs:subClassOf _:genid9
                      ] ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget _:genid9 ;
  rdfs:comment "g"
] .

_:genid9 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :C .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :j
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( [ ]
  ) ;
rdfs:comment "e"
] .


