@prefix : <http://example.org/predicate-twins-shared.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/predicate-twins-shared.owl> .

<http://example.org/predicate-twins-shared.owl> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/predicate-twins-shared.owl#q
:q rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/predicate-twins-shared.owl#A1
:A1 rdf:type owl:Class ;
    owl:equivalentClass _:genid1 ;
    rdfs:subClassOf _:genid1 .

_:genid1 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :B .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A1 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1 ;
   rdfs:comment "a"
 ] .


###  http://example.org/predicate-twins-shared.owl#A2
:A2 rdf:type owl:Class ;
    owl:equivalentClass _:genid3 ;
    rdfs:subClassOf _:genid3 .

_:genid3 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :B .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A2 ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "c"
 ] .


###  http://example.org/predicate-twins-shared.owl#A3
:A3 rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ;
                          owl:onProperty :q ;
                          owl:someValuesFrom :B
                        ] ;
    rdfs:subClassOf _:genid6 .

_:genid6 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :B .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A3 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid6 ;
   rdfs:comment "a"
 ] .


###  http://example.org/predicate-twins-shared.owl#B
:B rdf:type owl:Class .


