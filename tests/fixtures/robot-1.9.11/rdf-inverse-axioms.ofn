Prefix(:=<http://example.org/v#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/v>

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(Class(:D))
Declaration(Class(:E))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(ObjectProperty(:s))
Declaration(ObjectProperty(:t))
Declaration(DataProperty(:d))
Declaration(DataProperty(:e))
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(:j))

FunctionalObjectProperty(Annotation(rdfs:comment "functional inverse") ObjectInverseOf(:p))
TransitiveObjectProperty(ObjectInverseOf(:p))
ObjectPropertyDomain(Annotation(rdfs:comment "inverse domain") ObjectInverseOf(:p) :A)
ObjectPropertyRange(ObjectInverseOf(:p) :B)
ObjectPropertyRange(Annotation(rdfs:comment "inverse range") ObjectInverseOf(:q) ObjectSomeValuesFrom(:r :C))
SubObjectPropertyOf(Annotation(rdfs:comment "inverse sub") ObjectInverseOf(:q) :s)
SubObjectPropertyOf(Annotation(rdfs:comment "inverse sub inverse") ObjectInverseOf(:r) ObjectInverseOf(:t))
EquivalentObjectProperties(Annotation(rdfs:comment "inverse equivalents") ObjectInverseOf(:s) ObjectInverseOf(:t))
AnnotationAssertion(Annotation(rdfs:comment "label") rdfs:label :p "p")
SubObjectPropertyOf(Annotation(rdfs:comment "named sub") :p :q)

EquivalentObjectProperties(:p ObjectInverseOf(:t))
EquivalentObjectProperties(Annotation(rdfs:comment "equivalent to inverse") :q ObjectInverseOf(:r))
InverseObjectProperties(:p ObjectInverseOf(:s))
InverseObjectProperties(Annotation(rdfs:comment "inverse of inverse") :q ObjectInverseOf(:t))
SubObjectPropertyOf(:r ObjectInverseOf(:t))
SubObjectPropertyOf(Annotation(rdfs:comment "sub of inverse") :s ObjectInverseOf(:t))
DisjointObjectProperties(:p ObjectInverseOf(:r))
DisjointObjectProperties(Annotation(rdfs:comment "disjoint from inverse") :r ObjectInverseOf(:s))

NegativeObjectPropertyAssertion(Annotation(rdfs:comment "negative") :p :i :j)
NegativeObjectPropertyAssertion(Annotation(rdfs:comment "negative again") :p :i :j)
NegativeObjectPropertyAssertion(ObjectInverseOf(:q) :i :j)
NegativeObjectPropertyAssertion(Annotation(rdfs:comment "negative inverse") ObjectInverseOf(:r) :i :j)
NegativeDataPropertyAssertion(Annotation(rdfs:comment "negative data") :d :i "1"^^xsd:integer)

HasKey(:A (:q ObjectInverseOf(:p) :r) (:e :d))
HasKey(Annotation(rdfs:comment "key") :B (:r) (:d))
DisjointUnion(Annotation(rdfs:comment "union") :C :E :D)
HasKey(Annotation(rdfs:comment "anonymous key") ObjectSomeValuesFrom(:p :B) (ObjectInverseOf(:p) :q) (:d))
DisjointUnion(:D :E ObjectSomeValuesFrom(:p :A) ObjectIntersectionOf(:A :B))
EquivalentClasses(Annotation(rdfs:comment "counter") ObjectSomeValuesFrom(:t :C) ObjectAllValuesFrom(:t :C))
)
