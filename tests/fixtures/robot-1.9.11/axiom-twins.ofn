Prefix(:=<http://example.org/axiom-twins#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://example.org/axiom-twins>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(DataProperty(:d))
Declaration(AnnotationProperty(:ap))
Declaration(Datatype(:dt))
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(:j))
AnnotationPropertyDomain(Annotation(rdfs:comment "b") :ap :A)
AnnotationPropertyDomain(Annotation(rdfs:comment "a") :ap :A)
AnnotationPropertyRange(:ap :B)
AnnotationPropertyRange(Annotation(rdfs:comment "a") :ap :B)
ObjectPropertyDomain(Annotation(rdfs:comment "a") :p :A)
ObjectPropertyDomain(:p :A)
ObjectPropertyDomain(Annotation(rdfs:comment "b") :p ObjectSomeValuesFrom(:q :A))
ObjectPropertyDomain(Annotation(rdfs:comment "a") :p ObjectSomeValuesFrom(:q :A))
ObjectPropertyRange(:p ObjectSomeValuesFrom(:q :A))
ObjectPropertyRange(Annotation(rdfs:comment "c") :p ObjectSomeValuesFrom(:q :A))
ObjectPropertyDomain(Annotation(rdfs:comment "a") ObjectInverseOf(:q) ObjectSomeValuesFrom(:p :B))
ObjectPropertyDomain(Annotation(rdfs:comment "b") ObjectInverseOf(:q) ObjectSomeValuesFrom(:p :B))
SubObjectPropertyOf(Annotation(rdfs:comment "a") :r ObjectInverseOf(:q))
SubObjectPropertyOf(:r ObjectInverseOf(:q))
SubObjectPropertyOf(Annotation(rdfs:comment "b") :r ObjectInverseOf(:q))
DataPropertyDomain(:d ObjectSomeValuesFrom(:q :B))
DataPropertyDomain(Annotation(rdfs:comment "a") :d ObjectSomeValuesFrom(:q :B))
DataPropertyDomain(Annotation(rdfs:comment "a") :d :A)
DataPropertyDomain(:d :A)
DataPropertyRange(Annotation(rdfs:comment "b") :d DataOneOf("x" "y"))
DataPropertyRange(:d DataOneOf("x" "y"))
DataPropertyRange(Annotation(rdfs:comment "a") :d DataOneOf("x" "y"))
DataPropertyRange(Annotation(rdfs:comment "a") :d xsd:string)
DataPropertyRange(:d xsd:string)
DatatypeDefinition(Annotation(rdfs:comment "b") :dt DataOneOf("u" "v"))
DatatypeDefinition(:dt DataOneOf("u" "v"))
DatatypeDefinition(Annotation(rdfs:comment "a") :dt DataOneOf("u" "v"))
ClassAssertion(Annotation(rdfs:comment "b") ObjectSomeValuesFrom(:q :B) :i)
ClassAssertion(ObjectSomeValuesFrom(:q :B) :i)
ClassAssertion(Annotation(rdfs:comment "a") ObjectSomeValuesFrom(:q :B) :i)
ClassAssertion(Annotation(rdfs:comment "a") :A :i)
ClassAssertion(:A :i)
SameIndividual(Annotation(rdfs:comment "a") :i :j)
SameIndividual(:i :j)
DifferentIndividuals(:i :j)
DifferentIndividuals(Annotation(rdfs:comment "b") :i :j)
DifferentIndividuals(Annotation(rdfs:comment "a") :i :j)
SubClassOf(Annotation(rdfs:comment "b") :B ObjectSomeValuesFrom(:r :A))
SubClassOf(:B ObjectSomeValuesFrom(:r :A))
SubClassOf(Annotation(rdfs:comment "a") :B ObjectSomeValuesFrom(:r :A))
ObjectPropertyRange(ObjectInverseOf(:q) ObjectSomeValuesFrom(:p :A))
ObjectPropertyRange(Annotation(rdfs:comment "b") ObjectInverseOf(:q) ObjectSomeValuesFrom(:p :A))
ObjectPropertyRange(Annotation(rdfs:comment "a") ObjectInverseOf(:q) ObjectSomeValuesFrom(:p :A))
EquivalentClasses(Annotation(rdfs:comment "b") :A ObjectSomeValuesFrom(:q :B))
EquivalentClasses(Annotation(rdfs:comment "a") :A ObjectSomeValuesFrom(:q :B))
DisjointClasses(Annotation(rdfs:comment "b") :B ObjectSomeValuesFrom(:p :A))
DisjointClasses(:B ObjectSomeValuesFrom(:p :A))
DisjointClasses(Annotation(rdfs:comment "a") :B ObjectSomeValuesFrom(:p :A))
ObjectPropertyAssertion(:p :j _:x)
ClassAssertion(Annotation(rdfs:comment "b") ObjectSomeValuesFrom(:r :B) _:x)
ClassAssertion(ObjectSomeValuesFrom(:r :B) _:x)
ClassAssertion(Annotation(rdfs:comment "a") ObjectSomeValuesFrom(:r :B) _:x)
)
