Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)
Prefix(q:=<http://purl.obolibrary.org/obo/q#>)
Ontology(<http://purl.obolibrary.org/obo/q.owl>
Declaration(Class(<http://purl.obolibrary.org/obo/Q_1>))
Declaration(Class(<http://purl.obolibrary.org/obo/Q_2>))
Declaration(AnnotationProperty(q:comment))
Declaration(AnnotationProperty(q:domain))
Declaration(AnnotationProperty(q:custom))
Declaration(AnnotationProperty(<http://purl.obolibrary.org/obo/name>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/R_1>))
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/Q_2> "two")
AnnotationAssertion(q:comment <http://purl.obolibrary.org/obo/Q_1> "a q comment")
AnnotationAssertion(q:custom <http://purl.obolibrary.org/obo/Q_1> "custom")
AnnotationAssertion(q:domain <http://purl.obolibrary.org/obo/Q_1> "Q:2")
AnnotationAssertion(oboInOwl:domain <http://purl.obolibrary.org/obo/Q_1> "Q:3")
AnnotationAssertion(oboInOwl:relationship <http://purl.obolibrary.org/obo/Q_1> "R:1")
AnnotationAssertion(oboInOwl:is_a <http://purl.obolibrary.org/obo/Q_1> "Q:2")
AnnotationAssertion(oboInOwl:union_of <http://purl.obolibrary.org/obo/Q_1> "Q:2")
AnnotationAssertion(oboInOwl:domain <http://purl.obolibrary.org/obo/R_1> "Q:2")
AnnotationAssertion(oboInOwl:inverse_of <http://purl.obolibrary.org/obo/R_1> "R:9")
AnnotationAssertion(oboInOwl:relationship <http://purl.obolibrary.org/obo/R_1> "R:1")
AnnotationAssertion(<http://purl.obolibrary.org/obo/name> <http://purl.obolibrary.org/obo/Q_2> "named by obo/name")
)
