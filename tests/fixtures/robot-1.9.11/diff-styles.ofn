Ontology(<http://example.org/diff-styles>
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/diff-styles/v1>) Class(:A))
Declaration(Class(:B))
Declaration(ObjectProperty(:p))
Declaration(DataProperty(:d))
Declaration(AnnotationProperty(:ap))
Declaration(NamedIndividual(:j))
AnnotationAssertion(rdfs:label :A "a")
AnnotationPropertyRange(:ap xsd:string)
AnnotationPropertyDomain(:ap :B)
SubClassOf(:A ObjectMinCardinality(1 :p))
SubClassOf(:A DataMaxCardinality(2 :d))
SubClassOf(:B ObjectExactCardinality(1 :p :A))
DifferentIndividuals(:j :j)
DisjointObjectProperties(:p :p)
)
