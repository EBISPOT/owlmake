<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/inv#"
     xml:base="http://example.org/inv"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/inv"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/inv#a_parent -->

    <owl:ObjectProperty rdf:about="http://example.org/inv#a_parent">
        <owl:inverseOf rdf:resource="http://example.org/inv#z_child"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/inv#b_before -->

    <owl:ObjectProperty rdf:about="http://example.org/inv#b_before">
        <owl:inverseOf rdf:resource="http://example.org/inv#y_after"/>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/inv#b_before"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#inverseOf"/>
        <owl:annotatedTarget rdf:resource="http://example.org/inv#y_after"/>
        <rdfs:comment>stated by y_after</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://example.org/inv#has_part -->

    <owl:ObjectProperty rdf:about="http://example.org/inv#has_part">
        <owl:inverseOf rdf:resource="http://example.org/inv#part_of"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/inv#part_of -->

    <owl:ObjectProperty rdf:about="http://example.org/inv#part_of"/>
    


    <!-- http://example.org/inv#y_after -->

    <owl:ObjectProperty rdf:about="http://example.org/inv#y_after"/>
    


    <!-- http://example.org/inv#z_child -->

    <owl:ObjectProperty rdf:about="http://example.org/inv#z_child"/>
</rdf:RDF>



