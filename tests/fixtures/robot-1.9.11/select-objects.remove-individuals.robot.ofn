Prefix(:=<http://example.org/select-objects#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/select-objects>
Annotation(rdfs:comment "header")

Declaration(Class(<http://example.org/A>))
Declaration(Class(<http://example.org/B>))
Declaration(Class(<http://example.org/C>))
Declaration(Class(<http://example.org/D>))
Declaration(ObjectProperty(<http://example.org/p>))
Declaration(ObjectProperty(<http://example.org/q>))
Declaration(DataProperty(<http://example.org/d>))
Declaration(AnnotationProperty(<http://example.org/ap>))
Declaration(AnnotationProperty(<http://example.org/ap2>))
############################
#   Annotation Properties
############################

# Annotation Property: <http://example.org/ap> (<http://example.org/ap>)

AnnotationPropertyRange(<http://example.org/ap> <http://example.org/B>)
AnnotationPropertyDomain(<http://example.org/ap> <http://example.org/A>)

# Annotation Property: <http://example.org/ap2> (<http://example.org/ap2>)

SubAnnotationPropertyOf(<http://example.org/ap2> <http://example.org/ap>)


############################
#   Object Properties
############################

# Object Property: <http://example.org/p> (<http://example.org/p>)

ObjectPropertyDomain(<http://example.org/p> <http://example.org/A>)
ObjectPropertyRange(<http://example.org/p> ObjectUnionOf(<http://example.org/B> <http://example.org/C>))

# Object Property: <http://example.org/q> (<http://example.org/q>)

SubObjectPropertyOf(<http://example.org/q> <http://example.org/p>)


############################
#   Data Properties
############################

# Data Property: <http://example.org/d> (<http://example.org/d>)

DataPropertyDomain(<http://example.org/d> <http://example.org/D>)
DataPropertyRange(<http://example.org/d> xsd:integer)



############################
#   Classes
############################

# Class: <http://example.org/A> (<http://example.org/A>)

EquivalentClasses(<http://example.org/A> ObjectIntersectionOf(<http://example.org/B> ObjectSomeValuesFrom(<http://example.org/p> <http://example.org/C>)))
SubClassOf(<http://example.org/A> owl:Thing)
SubClassOf(Annotation(rdfs:comment "why") <http://example.org/A> owl:Thing)

# Class: <http://example.org/B> (B)

AnnotationAssertion(rdfs:label <http://example.org/B> "B"@en)
SubClassOf(<http://example.org/B> <http://example.org/A>)
DisjointClasses(<http://example.org/B> ObjectComplementOf(<http://example.org/C>))

# Class: <http://example.org/C> (C)

AnnotationAssertion(Annotation(rdfs:comment "src") rdfs:label <http://example.org/C> "C")
SubClassOf(<http://example.org/C> <http://example.org/B>)
SubClassOf(<http://example.org/C> ObjectSomeValuesFrom(<http://example.org/p> <http://example.org/A>))

# Class: <http://example.org/D> (<http://example.org/D>)

SubClassOf(<http://example.org/D> <http://example.org/C>)


)