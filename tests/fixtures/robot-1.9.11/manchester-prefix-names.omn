Prefix: rdfs: <http://www.w3.org/2000/01/rdf-schema#>

Ontology: <http://example.org/prefix-names>

Annotations:
    idsfor: "PN"

AnnotationProperty: idsfor:

AnnotationProperty: allocatedto:

ObjectProperty: part:

Class: organ:
    Annotations: rdfs:label "organ"
    SubClassOf: part: some organ:

Datatype: idrange:1
    Annotations:
        allocatedto: "ONTOLOGY-CREATOR"
    EquivalentTo:
        xsd:integer[>= 0 , <= 999999]

Individual: :heart
