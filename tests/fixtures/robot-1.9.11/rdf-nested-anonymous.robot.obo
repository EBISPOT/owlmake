mple.org/nest#j> <http://example.org/nest#i>)\nNegativeObjectPropertyAssertion(Annotation(Annotation(<http://example.org/nest#see> _:genid2147483657) rdfs:comment \"negative\") <http://example.org/nest#p> <http://example.org/nest#j> <http://example.org/nest#k>)\nDataPropertyAssertion(Annotation(Annotation(rdfs:comment \"data value\") <http://example.org/nest#see> _:genid2147483651) <http://example.org/nest#d> <http://example.org/nest#j> \"1\")\n\n# Individual: <http://example.org/nest#k> (<http://example.org/nest#k>)\n\nObjectPropertyAssertion(<http://example.org/nest#q> <http://example.org/nest#k> _:genid2147483652)\n\n# Individual: <http://example.org/nest#m> (<http://example.org/nest#m>)\n\nObjectPropertyAssertion(<http://example.org/nest#r> <http://example.org/nest#m> _:genid2147483660)\n\n\nSubClassOf(Annotation(Annotation(rdfs:comment \"gci value\") <http://example.org/nest#see> _:genid2147483654) ObjectSomeValuesFrom(<http://example.org/nest#p> <http://example.org/nest#A>) <http://example.org/nest#B>)\nDisjointClasses(Annotation(Annotation(<http://example.org/nest#see> _:genid2147483655) rdfs:comment \"disjoint\") <http://example.org/nest#A> <http://example.org/nest#C> <http://example.org/nest#D>)\nDifferentIndividuals(Annotation(Annotation(rdfs:comment \"different value\") <http://example.org/nest#see> _:genid2147483656) <http://example.org/nest#i> <http://example.org/nest#j> <http://example.org/nest#k>)\nObjectPropertyAssertion(<http://example.org/nest#q> _:genid2147483651 <http://example.org/nest#k>)\nDataPropertyAssertion(<http://example.org/nest#d> _:genid2147483651 \"2\")\nDLSafeRule(Annotation(Annotation(rdfs:comment \"rule value\") <http://example.org/nest#see> _:genid2147483661) Body(ClassAtom(<http://example.org/nest#A> Variable(<urn:swrl:var#x>)))Head(ClassAtom(<http://example.org/nest#B> Variable(<urn:swrl:var#x>))))\n)

