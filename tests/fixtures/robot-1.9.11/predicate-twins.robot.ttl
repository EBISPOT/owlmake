###  http://example.org/predicate-twins.owl#A1
:A1 rdf:type owl:Class ;
    owl:equivalentClass _:genid1 ;
    rdfs:subClassOf _:genid3 .

_:genid1 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :B .

_:genid3 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :B .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A1 ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid1 ;
   rdfs:comment "c"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A1 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "a"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A1 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "b"
 ] .


