###  http://example.org/predicate-twins.owl#A5
:A5 rdf:type owl:Class ;
    owl:equivalentClass _:genid16 ;
    rdfs:subClassOf _:genid19 ;
    owl:disjointWith [ rdf:type owl:Restriction ;
