    owl:equivalentClass [ rdf:type owl:Restriction ;
                          owl:onProperty :q ;
                          owl:someValuesFrom :B
                        ] ;
    rdfs:subClassOf _:genid7 .

_:genid7 rdf:type owl:Restriction ;
