<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xml-literal="http://example.org/xml-literal#">
    <Ontology/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/xml-literal#dp -->

    <DatatypeProperty rdf:about="http://example.org/xml-literal#dp"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/xml-literal#A -->

    <Class rdf:about="http://example.org/xml-literal#A">
        <rdfs:comment rdf:parseType="Literal"><b xmlns="http://example.org/b">bold &amp; <i>x</i></b></rdfs:comment>
        <rdfs:seeAlso rdf:parseType="Literal"><owl:Thing xmlns:owl="http://www.w3.org/2002/07/owl#"/></rdfs:seeAlso>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://example.org/xml-literal#A"/>
        <annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
        <annotatedTarget rdf:parseType="Literal"><owl:Thing xmlns:owl="http://www.w3.org/2002/07/owl#"/></annotatedTarget>
        <rdfs:label>annotated</rdfs:label>
    </Axiom>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/xml-literal#i -->

    <NamedIndividual rdf:about="http://example.org/xml-literal#i">
        <xml-literal:dp rdf:parseType="Literal"><p xmlns="http://example.org/p"><p>nested</p></p></xml-literal:dp>
    </NamedIndividual>
</rdf:RDF>



