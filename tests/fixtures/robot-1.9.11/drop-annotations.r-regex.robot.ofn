Prefix(:=<http://example.org/d#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)


Ontology(<http://example.org/d>
Annotation(Annotation(rdfs:comment "on the header") rdfs:label "Drop")

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(AnnotationProperty(oboInOwl:hasDbXref))
Declaration(AnnotationProperty(oboInOwl:source))


############################
#   Classes
############################

# Class: :A (a)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "X:1") rdfs:label :A "a")

# Class: :B (b)

AnnotationAssertion(Annotation(Annotation(rdfs:comment "nested") oboInOwl:source "PMID:2") rdfs:label :B "b")
SubClassOf(Annotation(oboInOwl:source "PMID:1") :B :A)

# Class: :C (c)

AnnotationAssertion(rdfs:label :C "c")
SubClassOf(Annotation(oboInOwl:source <http://example.org/src>) Annotation(rdfs:comment "bar") :C :A)
SubClassOf(:C :B)


)