Prefix(:=<http://example.org/r#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/rule4>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(Class(:D))
Declaration(ObjectProperty(:p))
Declaration(DataProperty(:d))
Declaration(NamedIndividual(:x))
Declaration(NamedIndividual(:y))
DLSafeRule(Body(ObjectPropertyAtom(:p Variable(<urn:swrl:var#x>) Variable(<urn:swrl:var#y>)) DataPropertyAtom(:d Variable(<urn:swrl:var#x>) Variable(<urn:swrl:var#v>)) DataRangeAtom(xsd:integer Variable(<urn:swrl:var#v>)) ClassAtom(ObjectComplementOf(:B) Variable(<urn:swrl:var#x>)) DifferentIndividualsAtom(Variable(<urn:swrl:var#x>) Variable(<urn:swrl:var#y>)) SameIndividualAtom(Variable(<urn:swrl:var#y>) :y) ClassAtom(:A Variable(<urn:swrl:var#x>))) Head(ClassAtom(:C Variable(<urn:swrl:var#y>)) DataPropertyAtom(:d Variable(<urn:swrl:var#y>) "7"^^xsd:integer)))
ObjectPropertyAssertion(:p :x :y)
DataPropertyAssertion(:d :x "5"^^xsd:integer)
ClassAssertion(ObjectComplementOf(:B) :x)
ClassAssertion(:A :x)
DifferentIndividuals(:x :y)
DisjointClasses(:C :D)
ClassAssertion(:D :y)
)
