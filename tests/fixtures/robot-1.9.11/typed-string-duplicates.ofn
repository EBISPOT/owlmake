Prefix(:=<http://example.org/typed-string-duplicates#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://example.org/typed-string-duplicates>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(DataProperty(:dp))
Declaration(NamedIndividual(:i))
AnnotationAssertion(rdfs:label :A "x")
AnnotationAssertion(rdfs:label :A "x"^^xsd:string)
AnnotationAssertion(rdfs:label :B "y"^^xsd:string)
AnnotationAssertion(rdfs:label :B "y")
AnnotationAssertion(rdfs:label :B "y"@en)
DataPropertyAssertion(:dp :i "v")
DataPropertyAssertion(:dp :i "v"^^xsd:string)
SubClassOf(:A DataHasValue(:dp "w"))
SubClassOf(:A DataHasValue(:dp "w"^^xsd:string))
)
