Prefix(:=<http://example.org/one-member-difference.owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/one-member-difference.owl>
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(:j))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(Class(:C))
ObjectPropertyAssertion(:p :i _:x)
DifferentIndividuals(_:x _:x)
DifferentIndividuals(Annotation(rdfs:comment "d") _:x _:x)
ObjectPropertyAssertion(Annotation(rdfs:comment "a") :q :i _:z)
ObjectPropertyAssertion(:q :j _:z)
DifferentIndividuals(:j :j)
DifferentIndividuals(Annotation(rdfs:comment "e") _:w _:w)
SubClassOf(Annotation(rdfs:comment "g") ObjectSomeValuesFrom(:p :C) ObjectSomeValuesFrom(:q :C))
)
