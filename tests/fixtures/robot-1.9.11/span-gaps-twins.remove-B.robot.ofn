Prefix(:=<http://example.org/props.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/props.owl>

Declaration(Class(<http://example.org/A>))
Declaration(Class(<http://example.org/C>))
Declaration(Class(<http://example.org/D>))
Declaration(ObjectProperty(<http://example.org/p>))
Declaration(ObjectProperty(<http://example.org/q>))
Declaration(ObjectProperty(<http://example.org/r>))
Declaration(DataProperty(<http://example.org/d>))
Declaration(DataProperty(<http://example.org/e>))
Declaration(AnnotationProperty(<http://example.org/x>))
Declaration(AnnotationProperty(<http://example.org/y>))
############################
#   Annotation Properties
############################

# Annotation Property: <http://example.org/x> (<http://example.org/x>)

SubAnnotationPropertyOf(<http://example.org/x> <http://example.org/y>)
SubAnnotationPropertyOf(Annotation(rdfs:comment "ann") <http://example.org/x> <http://example.org/y>)


############################
#   Object Properties
############################

# Object Property: <http://example.org/p> (<http://example.org/p>)

SubObjectPropertyOf(<http://example.org/p> <http://example.org/q>)
SubObjectPropertyOf(Annotation(rdfs:comment "ann") <http://example.org/p> <http://example.org/q>)

# Object Property: <http://example.org/r> (<http://example.org/r>)

SubObjectPropertyOf(<http://example.org/r> ObjectInverseOf(<http://example.org/q>))


############################
#   Data Properties
############################

# Data Property: <http://example.org/d> (<http://example.org/d>)

SubDataPropertyOf(<http://example.org/d> <http://example.org/e>)
SubDataPropertyOf(Annotation(rdfs:comment "ann") <http://example.org/d> <http://example.org/e>)



############################
#   Classes
############################

# Class: <http://example.org/C> (<http://example.org/C>)

SubClassOf(<http://example.org/C> <http://example.org/A>)
SubClassOf(<http://example.org/C> <http://example.org/D>)
SubClassOf(Annotation(rdfs:comment "kept") <http://example.org/C> <http://example.org/D>)


)