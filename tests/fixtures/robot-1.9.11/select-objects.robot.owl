<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/select-objects#"
     xml:base="http://example.org/select-objects"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:example="http://example.org/">
    <owl:Ontology rdf:about="http://example.org/select-objects">
        <rdfs:comment>header</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/ap -->

    <owl:AnnotationProperty rdf:about="http://example.org/ap">
        <rdfs:range rdf:resource="http://example.org/B"/>
        <rdfs:domain rdf:resource="http://example.org/A"/>
    </owl:AnnotationProperty>
    


    <!-- http://example.org/ap2 -->

    <owl:AnnotationProperty rdf:about="http://example.org/ap2">
        <rdfs:subPropertyOf rdf:resource="http://example.org/ap"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/p -->

    <owl:ObjectProperty rdf:about="http://example.org/p">
        <rdfs:domain rdf:resource="http://example.org/A"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/B"/>
                    <rdf:Description rdf:about="http://example.org/C"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://example.org/q -->

    <owl:ObjectProperty rdf:about="http://example.org/q">
        <rdfs:subPropertyOf rdf:resource="http://example.org/p"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/d -->

    <owl:DatatypeProperty rdf:about="http://example.org/d">
        <rdfs:domain rdf:resource="http://example.org/D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/A -->

    <owl:Class rdf:about="http://example.org/A">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/B"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/p"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/C"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/A"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>why</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://example.org/B -->

    <owl:Class rdf:about="http://example.org/B">
        <rdfs:subClassOf rdf:resource="http://example.org/A"/>
        <owl:disjointWith>
            <owl:Class>
                <owl:complementOf rdf:resource="http://example.org/C"/>
            </owl:Class>
        </owl:disjointWith>
        <rdfs:label xml:lang="en">B</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/C -->

    <owl:Class rdf:about="http://example.org/C">
        <rdfs:subClassOf rdf:resource="http://example.org/B"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/p"/>
                <owl:someValuesFrom rdf:resource="http://example.org/A"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <example:ap rdf:resource="http://example.org/A"/>
        <rdfs:label>C</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/C"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>C</owl:annotatedTarget>
        <rdfs:comment>src</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://example.org/D -->

    <owl:Class rdf:about="http://example.org/D">
        <rdfs:subClassOf rdf:resource="http://example.org/C"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/A -->

    <owl:NamedIndividual rdf:about="http://example.org/A">
        <rdf:type rdf:resource="http://example.org/B"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/i -->

    <owl:NamedIndividual rdf:about="http://example.org/i">
        <rdf:type rdf:resource="http://example.org/D"/>
        <example:p rdf:resource="http://example.org/A"/>
        <example:d rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</example:d>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://example.org/A">
        <rdfs:label>A</rdfs:label>
    </rdf:Description>
</rdf:RDF>



