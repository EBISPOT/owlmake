@prefix : <http://example.org/anon#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix anon: <http://example.org/anon#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/anon> .

<http://example.org/anon> rdf:type owl:Ontology ;
                           anon:note [ rdf:type anon:A ;
                                       anon:d "header"
                                     ] .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/anon#note
anon:note rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/anon#p
anon:p rdf:type owl:ObjectProperty .


###  http://example.org/anon#q
anon:q rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.org/anon#d
anon:d rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/anon#A
anon:A rdf:type owl:Class ;
       anon:note [ rdfs:label "note"
                 ] .


###  http://example.org/anon#B
anon:B rdf:type owl:Class ;
       anon:note _:genid3 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource anon:B ;
   owl:annotatedProperty anon:note ;
   owl:annotatedTarget _:genid3 ;
   rdfs:comment "on"
 ] .


###  http://example.org/anon#C
anon:C rdf:type owl:Class ;
       rdfs:subClassOf anon:D .

[ rdf:type owl:Axiom ;
   owl:annotatedSource anon:C ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget anon:D ;
   anon:note _:genid6
 ] .

_:genid6 rdf:type anon:A .


###  http://example.org/anon#D
anon:D rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/anon#i
anon:i rdf:type owl:NamedIndividual ;
       anon:p _:genid7 ;
       anon:q _:genid9 .

_:genid7 anon:q [ rdf:type anon:D
                 ] .

_:genid9 anon:d 3 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource anon:i ;
   owl:annotatedProperty anon:q ;
   owl:annotatedTarget _:genid9 ;
   rdfs:comment "annotated"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource _:genid9 ;
   owl:annotatedProperty anon:d ;
   owl:annotatedTarget 3 ;
   rdfs:comment "pulled"
 ] .


###  http://example.org/anon#j
anon:j rdf:type owl:NamedIndividual ;
       anon:q [ rdf:type anon:A
              ] .


###  http://example.org/anon#k
anon:k rdf:type owl:NamedIndividual ;
       owl:differentFrom _:genid13 .

[ rdf:type owl:Axiom ;
   owl:annotatedSource anon:k ;
   owl:annotatedProperty owl:differentFrom ;
   owl:annotatedTarget _:genid13 ;
   rdfs:comment "apart"
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual anon:k ;
   owl:assertionProperty anon:d ;
   owl:targetValue "5"
 ] .


[ rdf:type anon:A ,
           owl:Thing
] .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
   owl:onProperty anon:q ;
   owl:hasValue _:genid18 ;
   rdfs:subClassOf anon:D
 ] .

_:genid18 rdf:type anon:C .

[ rdf:type owl:Axiom ;
   owl:annotatedSource _:genid18 ;
   owl:annotatedProperty rdf:type ;
   owl:annotatedTarget anon:C ;
   rdfs:comment "general"
 ] .


