Prefix(:=<http://example.org/ext#>)
Prefix(e:=<http://example.org/other#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/ext>

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(e:D))
Declaration(Class(e:W))
Declaration(Class(e:Y))
Declaration(Class(e:Z))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(e:i3))

############################
#   Classes
############################

# Class: :A (:A)

EquivalentClasses(:A ObjectSomeValuesFrom(:p owl:Thing))
SubClassOf(:A owl:Thing)

# Class: :B (:B)

SubClassOf(:B owl:Thing)

# Class: e:D (e:D)

EquivalentClasses(e:D ObjectSomeValuesFrom(:q owl:Thing))

# Class: e:W (e:W)

SubClassOf(e:W :A)
SubClassOf(e:W ObjectSomeValuesFrom(:p :B))

# Class: e:Z (e:Z)

SubClassOf(e:Z e:Y)


############################
#   Named Individuals
############################

# Individual: :i (:i)

ClassAssertion(:A :i)
ClassAssertion(ObjectSomeValuesFrom(:p :B) :i)

# Individual: e:i3 (e:i3)

ClassAssertion(e:D e:i3)
ObjectPropertyAssertion(:q e:i3 :i)


)