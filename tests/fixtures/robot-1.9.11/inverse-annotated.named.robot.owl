                <example:p rdf:resource="http://example.org/s"/>
            </rdf:Description>
        </owl:annotatedSource>
        <owl:annotatedProperty rdf:resource="http://example.org/p"/>
        <owl:annotatedTarget rdf:resource="http://example.org/s"/>
