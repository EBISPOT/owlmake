        </owl:annotatedSource>
        <owl:annotatedProperty rdf:resource="http://example.org/p"/>
        <owl:annotatedTarget rdf:nodeID="genid6"/>
        <rdfs:comment>three</rdfs:comment>
    </owl:Axiom>
    <rdf:Description rdf:nodeID="genid6">
