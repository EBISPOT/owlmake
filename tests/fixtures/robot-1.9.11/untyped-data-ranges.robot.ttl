                                          owl:hasValue <http://example.org/i>
                                        ] .


###  http://example.org/A6
<http://example.org/A6> rdf:type owl:Class ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty <http://example.org/p> ;
                                          owl:hasValue "lit"
                                        ] .


###  http://example.org/A7
<http://example.org/A7> rdf:type owl:Class ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
