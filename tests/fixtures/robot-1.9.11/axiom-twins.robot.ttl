###  http://example.org/axiom-twins#q
:q rdf:type owl:ObjectProperty .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :q ;
                         rdfs:domain _:genid16
                       ] ;
   owl:annotatedProperty rdfs:domain ;
   owl:annotatedTarget _:genid16 ;
   rdfs:comment "a"
 ] .

_:genid16 rdf:type owl:Restriction ;
           owl:onProperty :p ;
           owl:someValuesFrom :B .

