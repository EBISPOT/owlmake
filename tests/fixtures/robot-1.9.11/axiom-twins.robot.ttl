#################################################################
#    Annotation properties
#################################################################

###  http://example.org/axiom-twins#ap
:ap rdf:type owl:AnnotationProperty ;
    rdfs:range :B ;
    rdfs:domain :A .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ap ;
   owl:annotatedProperty rdfs:range ;
   owl:annotatedTarget :B ;
   rdfs:comment "a"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ap ;
   owl:annotatedProperty rdfs:domain ;
   owl:annotatedTarget :A ;
   rdfs:comment "a"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ap ;
   owl:annotatedProperty rdfs:domain ;
   owl:annotatedTarget :A ;
   rdfs:comment "b"
 ] .


#################################################################
#    Datatypes
#################################################################

###  http://example.org/axiom-twins#dt
:dt rdf:type rdfs:Datatype ;
    owl:equivalentClass _:genid4 .

_:genid4 rdf:type rdfs:Datatype ;
          owl:oneOf [ rdf:type rdf:List ;
                      rdf:first "u" ;
                      rdf:rest [ rdf:type rdf:List ;
                                 rdf:first "v" ;
                                 rdf:rest rdf:nil
                               ]
                    ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :dt ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid4 ;
   rdfs:comment "a"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :dt ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid4 ;
   rdfs:comment "b"
 ] .


