                         rdfs:domain _:genid16
                       ] ;
   owl:annotatedProperty rdfs:domain ;
   owl:annotatedTarget _:genid16 ;
   rdfs:comment "b"
 ] .

[ owl:inverseOf :q ;
   rdfs:range _:genid21
 ] .

_:genid21 rdf:type owl:Restriction ;
           owl:onProperty :p ;
           owl:someValuesFrom :A .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :q ;
                         rdfs:range _:genid21
                       ] ;
   owl:annotatedProperty rdfs:range ;
   owl:annotatedTarget _:genid21 ;
   rdfs:comment "a"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :q ;
                         rdfs:range _:genid21
                       ] ;
   owl:annotatedProperty rdfs:range ;
   owl:annotatedTarget _:genid21 ;
   rdfs:comment "b"
 ] .


