<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/untyped.owl#"
     xml:base="http://example.org/untyped.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/untyped.owl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/p -->

    <owl:ObjectProperty rdf:about="http://example.org/p"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/A -->

    <owl:Class rdf:about="http://example.org/A">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/B"/>
                    <rdf:Description rdf:about="http://example.org/C"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/p"/>
                <owl:someValuesFrom rdf:resource="http://example.org/B"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/B -->

    <owl:Class rdf:about="http://example.org/B">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/A"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/p"/>
                        <owl:allValuesFrom rdf:resource="http://example.org/C"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf rdf:resource="http://example.org/C"/>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/C -->

    <owl:Class rdf:about="http://example.org/C">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/i"/>
                    <rdf:Description rdf:about="http://example.org/j"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/i -->

    <owl:NamedIndividual rdf:about="http://example.org/i"/>
    


    <!-- http://example.org/j -->

    <owl:NamedIndividual rdf:about="http://example.org/j"/>
</rdf:RDF>



