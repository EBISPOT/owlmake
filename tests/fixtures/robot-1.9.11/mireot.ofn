Prefix(:=<http://example.org/mireot#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(dc:=<http://purl.org/dc/elements/1.1/>)
Prefix(oio:=<http://www.geneontology.org/formats/oboInOwl#>)
Ontology(<http://example.org/mireot> <http://example.org/mireot/v1>
Import(<http://example.org/mireot-child>)
Annotation(dc:title "the mireot input")
Annotation(rdfs:comment "a header comment")
Declaration(Class(:X))
Declaration(Class(:Y))
Declaration(Class(:Z))
Declaration(Class(:Z2))
Declaration(Class(:Top))
Declaration(Class(:Q))
Declaration(Class(:W))
Declaration(Class(:E))
Declaration(Class(:R1))
Declaration(Class(:R2))
Declaration(Class(:K))
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(Class(:Up))
Declaration(Class(:Pun))
Declaration(Class(:Mid))
Declaration(Class(:D))
Declaration(Class(:Br))
Declaration(Class(:C1))
Declaration(Class(:C2))
Declaration(Class(:G1))
Declaration(Class(:G2))
Declaration(Class(:H))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:p2))
Declaration(ObjectProperty(:p3))
Declaration(ObjectProperty(:p4))
Declaration(ObjectProperty(:pi))
Declaration(ObjectProperty(:r))
Declaration(ObjectProperty(:s))
Declaration(ObjectProperty(:inv))
Declaration(ObjectProperty(:q))
Declaration(DataProperty(:d))
Declaration(DataProperty(:d2))
Declaration(DataProperty(:d4))
Declaration(DataProperty(:dd))
Declaration(DataProperty(:dup))
Declaration(AnnotationProperty(:ap))
Declaration(AnnotationProperty(:ap2))
Declaration(AnnotationProperty(:a1))
Declaration(AnnotationProperty(:apb))
Declaration(NamedIndividual(:i1))
Declaration(NamedIndividual(:Pun))
Declaration(Datatype(:dt))
AnnotationAssertion(rdfs:label :X "ex"@en)
AnnotationAssertion(rdfs:label :X "ex2")
AnnotationAssertion(oio:hasExactSynonym :X "exx")
AnnotationAssertion(rdfs:label :Y "why")
AnnotationAssertion(Annotation(rdfs:comment "on the label") rdfs:label :Z "zed")
AnnotationAssertion(rdfs:label :Q "queue")
AnnotationAssertion(rdfs:label :W "double-u")
AnnotationAssertion(rdfs:label :E "ee")
AnnotationAssertion(rdfs:label :R1 "r one")
AnnotationAssertion(rdfs:label :K "kay")
AnnotationAssertion(rdfs:label :A "ay")
AnnotationAssertion(rdfs:label :B "bee")
AnnotationAssertion(rdfs:label :C "see")
AnnotationAssertion(rdfs:label :Up "up")
AnnotationAssertion(rdfs:label :Pun "pun")
AnnotationAssertion(rdfs:label :Mid "mid")
AnnotationAssertion(rdfs:label :L "ell from the input")
AnnotationAssertion(rdfs:label :D "dee")
AnnotationAssertion(owl:deprecated :D "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label :Br "branch root")
AnnotationAssertion(rdfs:label :C1 "child one")
AnnotationAssertion(rdfs:comment :C1 "a comment on child one")
AnnotationAssertion(rdfs:label :C2 "child two")
AnnotationAssertion(rdfs:label :G1 "grandchild one")
AnnotationAssertion(rdfs:label :G2 "grandchild two")
AnnotationAssertion(rdfs:label :H "great-grandchild")
AnnotationAssertion(rdfs:label :p "pee")
AnnotationAssertion(rdfs:label :p2 "pee two")
AnnotationAssertion(rdfs:label :p3 "pee three")
AnnotationAssertion(rdfs:label :pi "pee eye")
AnnotationAssertion(rdfs:label :d "dee prop")
AnnotationAssertion(rdfs:label :d2 "dee two")
AnnotationAssertion(rdfs:label :dd "dee dee")
AnnotationAssertion(rdfs:label :ap "ay pee")
AnnotationAssertion(rdfs:label :a1 "ay one")
AnnotationAssertion(rdfs:label :apb "ay pee branch")
AnnotationAssertion(rdfs:label :i1 "eye one")
AnnotationAssertion(rdfs:comment :i1 "a comment on eye one")
AnnotationAssertion(rdfs:label :dt "dee tee")
SubClassOf(:X :Y)
SubClassOf(:Y :Z)
SubClassOf(:Y :Z2)
SubClassOf(:Z2 owl:Thing)
SubClassOf(:Z :Top)
EquivalentClasses(:Q ObjectIntersectionOf(:Y ObjectSomeValuesFrom(:p :W)))
SubClassOf(:E ObjectSomeValuesFrom(:p :W))
SubClassOf(:R1 :R2)
SubClassOf(:R2 :R1)
SubClassOf(:K :R2)
SubClassOf(:C :A)
EquivalentClasses(:A :B)
SubClassOf(:B :Up)
SubClassOf(:Pun :Up)
SubClassOf(:Mid :L)
SubClassOf(:D :Top)
SubClassOf(:C1 :Br)
SubClassOf(:C2 :Br)
SubClassOf(:G1 :C1)
SubClassOf(:G2 :C1)
SubClassOf(:H :G1)
SubObjectPropertyOf(:p :p2)
SubObjectPropertyOf(:p2 :p3)
EquivalentObjectProperties(:p :p4)
InverseObjectProperties(:pi :r)
SubObjectPropertyOf(:r :s)
SubObjectPropertyOf(:inv ObjectInverseOf(:q))
SubDataPropertyOf(:d :d2)
EquivalentDataProperties(:d :d4)
SubDataPropertyOf(:d4 :dup)
SubDataPropertyOf(:dd :dup)
SubAnnotationPropertyOf(:ap :ap2)
SubAnnotationPropertyOf(:a1 :apb)
ClassAssertion(:X :i1)
ClassAssertion(:Up :Pun)
)
