Prefix(:=<http://example.org/repair#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://example.org/repair>
Annotation(rdfs:seeAlso :A)
Annotation(rdfs:comment "about :A")

Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(Class(:D))
Declaration(Class(:E))
Declaration(Class(:F))
Declaration(Class(:G))
Declaration(Class(:H))
Declaration(Class(:P1))
Declaration(Class(:P2))
Declaration(Class(:U))
Declaration(Class(:V))
Declaration(Class(:W))
Declaration(Class(:X))
Declaration(Class(:Y))
Declaration(Class(:Z))
Declaration(Class(:Old))
Declaration(Class(:Mid))
Declaration(Class(:New))
Declaration(Class(:Kept))
Declaration(Class(:Lit))
Declaration(Class(:Bare))
Declaration(Class(:Pun))
Declaration(ObjectProperty(:Pun))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:s))
Declaration(ObjectProperty(:t))
Declaration(ObjectProperty(:u))
Declaration(ObjectProperty(:v))
Declaration(ObjectProperty(:w))
Declaration(DataProperty(:dp))
Declaration(DataProperty(:dq))
Declaration(AnnotationProperty(:ap))
Declaration(AnnotationProperty(:aq))
Declaration(NamedIndividual(:i))
Declaration(NamedIndividual(:j))
Declaration(NamedIndividual(:k))

# A class: its own axioms stay, every other reference moves.
AnnotationAssertion(owl:deprecated :A "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :A :B)
AnnotationAssertion(rdfs:label :A "obsolete a")
AnnotationAssertion(rdfs:comment :A "a comment")
AnnotationAssertion(oboInOwl:hasDbXref :A "X:1")
AnnotationAssertion(Annotation(rdfs:comment "source") oboInOwl:hasExactSynonym :A "a synonym")
AnnotationAssertion(rdfs:seeAlso :C :A)
SubClassOf(Annotation(rdfs:comment "own") :A :D)
SubClassOf(Annotation(rdfs:comment "reference") :C :A)
EquivalentClasses(:A :X)
DisjointClasses(:A :Y)
DisjointUnion(:A :P1 :P2)
DisjointUnion(:U :A :V)
HasKey(:A (:p) ())
ClassAssertion(:A :i)
SubClassOf(:E ObjectSomeValuesFrom(:p :A))
EquivalentClasses(:Z ObjectIntersectionOf(:A :W))
SubClassOf(Annotation(rdfs:seeAlso :A) :G :H)
SubClassOf(ObjectIntersectionOf(:A :F) :H)

# An object property: axioms about it stay, as itself and not as an inverse.
AnnotationAssertion(owl:deprecated :p "1"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :p :q)
SubObjectPropertyOf(:p :s)
SubObjectPropertyOf(:t :p)
SubObjectPropertyOf(ObjectInverseOf(:p) :v)
SubObjectPropertyOf(ObjectPropertyChain(:p :v) :w)
InverseObjectProperties(:u :p)
FunctionalObjectProperty(:p)
FunctionalObjectProperty(ObjectInverseOf(:p))
ObjectPropertyDomain(:p :X)
ObjectPropertyRange(ObjectInverseOf(:p) :Y)
ObjectPropertyAssertion(:p :i :j)

# A data property, an annotation property and an individual keep only their
# declarations and annotation assertions.
AnnotationAssertion(owl:deprecated :dp "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :dp :dq)
DataPropertyDomain(:dp :X)
DataPropertyAssertion(:dp :i "x")
AnnotationAssertion(owl:deprecated :ap "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :ap :aq)
SubAnnotationPropertyOf(:ap rdfs:comment)
AnnotationAssertion(:ap :X "v")
AnnotationAssertion(owl:deprecated :i "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :i :k)
SameIndividual(:i :j)

# A chain is not followed; a replacement given as a CURIE or by a bare name;
# a replacement of a term that is not deprecated; a punned term.
AnnotationAssertion(owl:deprecated :Old "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :Old :Mid)
AnnotationAssertion(owl:deprecated :Mid "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :Mid :New)
SubClassOf(:C :Old)
SubClassOf(:D :Mid)
AnnotationAssertion(owl:deprecated :Lit "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :Lit "GO:0000001")
SubClassOf(:E :Lit)
AnnotationAssertion(owl:deprecated :Bare "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :Bare "New")
SubClassOf(:F :Bare)
AnnotationAssertion(obo:IAO_0100001 :Kept :New)
SubClassOf(:G :Kept)
AnnotationAssertion(owl:deprecated :Pun "true"^^xsd:boolean)
AnnotationAssertion(obo:IAO_0100001 :Pun :New)
SubClassOf(:Pun :X)
SubObjectPropertyOf(:Pun :s)
SubClassOf(:H ObjectSomeValuesFrom(:Pun :Pun))
DLSafeRule(Body(ClassAtom(:Pun Variable(<urn:swrl:var#x>))) Head(ClassAtom(:X Variable(<urn:swrl:var#x>))))

# Twins for the merge of axiom annotations, and twins only once :A is
# replaced.
SubClassOf(Annotation(rdfs:comment "x") :W :X)
SubClassOf(Annotation(rdfs:comment "y") :W :X)
SubClassOf(:W :X)
SubClassOf(Annotation(rdfs:comment "m1") :W :A)
SubClassOf(Annotation(rdfs:comment "m2") :W :B)
)
