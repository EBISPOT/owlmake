Prefix(:=<http://example.org/mireot-order#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/mireot-order>

Declaration(Class(:A))
Declaration(Class(:H))
Declaration(AnnotationProperty(rdfs:comment))
Declaration(AnnotationProperty(rdfs:label))


############################
#   Classes
############################

# Class: :A (:A)

AnnotationAssertion(Annotation(rdfs:label "about a") rdfs:comment :A "a note")
SubClassOf(:A owl:Thing)

# Class: :H (aitch)

AnnotationAssertion(rdfs:label :H "aitch")
SubClassOf(:H owl:Thing)


)