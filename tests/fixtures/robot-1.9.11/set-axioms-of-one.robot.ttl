@prefix : <http://example.org/set-axioms-of-one#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/set-axioms-of-one> .

<http://example.org/set-axioms-of-one> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/set-axioms-of-one#p
:p rdf:type owl:ObjectProperty .

[ rdf:type owl:AllDisjointProperties ;
   owl:members ( :p
               )
 ] .


###  http://example.org/set-axioms-of-one#q
:q rdf:type owl:ObjectProperty .

[ rdfs:comment "inverse" ;
   rdf:type owl:AllDisjointProperties ;
   owl:members ( [ owl:inverseOf :q
                 ]
               )
 ] .


#################################################################
#    Data properties
#################################################################

###  http://example.org/set-axioms-of-one#d
:d rdf:type owl:DatatypeProperty .

[ rdf:type owl:AllDisjointProperties ;
   owl:members ( :d
               )
 ] .


#################################################################
#    Classes
#################################################################

###  http://example.org/set-axioms-of-one#A
:A rdf:type owl:Class ;
   rdfs:subClassOf _:genid8 .

_:genid8 rdf:type owl:Restriction ;
          owl:onProperty :p ;
          owl:someValuesFrom :B .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :A ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid8 ;
   rdfs:comment "x"
 ] .


###  http://example.org/set-axioms-of-one#B
:B rdf:type owl:Class ;
   rdfs:subClassOf _:genid10 .

_:genid10 rdf:type owl:Restriction ;
           owl:onProperty :q ;
           owl:someValuesFrom :A .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :B ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid10 ;
   rdfs:comment "y"
 ] .


###  http://example.org/set-axioms-of-one#V
:V rdf:type owl:Class ;
   owl:disjointUnionOf ( :B
                       ) .


