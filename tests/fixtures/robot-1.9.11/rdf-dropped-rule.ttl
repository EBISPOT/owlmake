@prefix : <http://example.org/drop#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix drop: <http://example.org/drop#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@base <http://example.org/drop> .

<http://example.org/drop> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/drop#ap
drop:ap rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/drop#p
drop:p rdf:type owl:ObjectProperty .


###  http://example.org/drop#q
drop:q rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/drop#A
drop:A rdf:type owl:Class .


###  http://example.org/drop#B
drop:B rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/drop#i
drop:i rdf:type owl:NamedIndividual .


###  http://example.org/drop#j
drop:j rdf:type owl:NamedIndividual .


###  http://example.org/drop#k
drop:k rdf:type owl:NamedIndividual .


#################################################################
#    Rules
#################################################################

drop:v rdf:type swrl:Variable .

[ rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate drop:A ;
                           swrl:argument1 drop:v
                         ] ;
               rdf:rest rdf:nil
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate drop:p ;
                           swrl:argument1 drop:v ;
                           swrl:argument2 [ ]
               ] ;
             rdf:rest rdf:nil
   ]
] .

