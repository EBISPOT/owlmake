Prefix(:=<http://example.org/g#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/g>
Declaration(Class(:A))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
EquivalentClasses(Annotation(rdfs:comment "anonymous pair") ObjectSomeValuesFrom(:p ObjectSomeValuesFrom(:q :A)) ObjectSomeValuesFrom(:q :A))
SubClassOf(Annotation(rdfs:comment "gci") ObjectSomeValuesFrom(:p :A) ObjectSomeValuesFrom(:q :A))
SubClassOf(Annotation(rdfs:comment "gci with another comment") ObjectSomeValuesFrom(:p :A) ObjectSomeValuesFrom(:q :A))
DisjointClasses(Annotation(rdfs:comment "disjoint pair") ObjectSomeValuesFrom(:r :A) ObjectSomeValuesFrom(:q :A))
DisjointClasses(Annotation(rdfs:comment "disjoint pair again") ObjectSomeValuesFrom(:r :A) ObjectSomeValuesFrom(:q :A))
SubClassOf(Annotation(rdfs:comment "universal") ObjectSomeValuesFrom(:p :A) ObjectAllValuesFrom(:q :A))
SubClassOf(ObjectSomeValuesFrom(:r :A) ObjectSomeValuesFrom(:q :A))
)
