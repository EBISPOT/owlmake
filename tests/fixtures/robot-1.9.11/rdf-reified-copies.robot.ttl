###  http://example.org/A
<http://example.org/A> rdf:type owl:Class ;
                       owl:equivalentClass _:genid1 ;
                       rdfs:subClassOf _:genid6 .

_:genid1 owl:intersectionOf ( <http://example.org/B>
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://example.org/p> ;
                                 owl:someValuesFrom <http://example.org/C>
                               ]
                             ) ;
          rdf:type owl:Class .

_:genid6 rdf:type owl:Restriction ;
          owl:onProperty <http://example.org/p> ;
          owl:someValuesFrom <http://example.org/B> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://example.org/A> ;
   owl:annotatedProperty owl:equivalentClass ;
   owl:annotatedTarget _:genid1 ;
   rdfs:comment "copied target"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://example.org/A> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid6 ;
   rdfs:comment "copied restriction"
 ] .


