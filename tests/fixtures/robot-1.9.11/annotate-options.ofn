Prefix(:=<http://example.org/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(prov:=<http://www.w3.org/ns/prov#>)
Prefix(dc:=<http://purl.org/dc/elements/1.1/>)

Ontology(<http://example.org/in.owl> <http://example.org/releases/1/in.owl>
Annotation(rdfs:comment "header")
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(owl:Thing))
Declaration(ObjectProperty(:op))
Declaration(DataProperty(:dp))
Declaration(NamedIndividual(:i))
Declaration(AnnotationProperty(dc:title))
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/other>) :A :B)
SubClassOf(Annotation(rdfs:comment "c") :B owl:Thing)
SubClassOf(:C :A)
AnnotationAssertion(rdfs:isDefinedBy :B <http://example.org/elsewhere>)
AnnotationAssertion(rdfs:label :A "a")
AnnotationAssertion(dc:title :i "eye")
ClassAssertion(:A :i)
DataPropertyAssertion(:dp :i "1"^^xsd:integer)
)
