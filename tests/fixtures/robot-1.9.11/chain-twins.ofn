Prefix(:=<http://example.org/chain-twins.owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/chain-twins.owl>
Declaration(Class(:A))
Declaration(Class(:A2))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(Class(:D))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(ObjectProperty(:r))
Declaration(ObjectProperty(:s))
Declaration(DataProperty(:d))
Declaration(DataProperty(:e))
Declaration(DataProperty(:f))
Declaration(NamedIndividual(:a))
Declaration(NamedIndividual(:b))
Declaration(NamedIndividual(:c))
EquivalentClasses(Annotation(rdfs:comment "c") :A :B ObjectSomeValuesFrom(:q :B))
EquivalentClasses(Annotation(rdfs:comment "e") :A :B ObjectSomeValuesFrom(:q :B))
EquivalentClasses(:A :B ObjectSomeValuesFrom(:q :B))
EquivalentClasses(Annotation(rdfs:comment "c") :A2 ObjectSomeValuesFrom(:q :C) ObjectSomeValuesFrom(:q :D))
EquivalentClasses(Annotation(rdfs:comment "e") :A2 ObjectSomeValuesFrom(:q :C) ObjectSomeValuesFrom(:q :D))
EquivalentClasses(:A2 ObjectSomeValuesFrom(:q :C) ObjectSomeValuesFrom(:q :D))
EquivalentClasses(Annotation(rdfs:comment "c") ObjectSomeValuesFrom(:p :B) ObjectSomeValuesFrom(:p :C) ObjectSomeValuesFrom(:p :D))
EquivalentClasses(ObjectSomeValuesFrom(:p :B) ObjectSomeValuesFrom(:p :C) ObjectSomeValuesFrom(:p :D))
SubClassOf(Annotation(rdfs:comment "g") ObjectSomeValuesFrom(:p :C) ObjectSomeValuesFrom(:p :D))
EquivalentObjectProperties(Annotation(rdfs:comment "c") :p :q ObjectInverseOf(:r))
EquivalentObjectProperties(Annotation(rdfs:comment "e") :p :q ObjectInverseOf(:r))
EquivalentObjectProperties(:p :q ObjectInverseOf(:r))
EquivalentObjectProperties(Annotation(rdfs:comment "c") :s ObjectInverseOf(:p) ObjectInverseOf(:q))
EquivalentObjectProperties(Annotation(rdfs:comment "e") :s ObjectInverseOf(:p) ObjectInverseOf(:q))
SubObjectPropertyOf(Annotation(rdfs:comment "x") :s ObjectInverseOf(:r))
SameIndividual(Annotation(rdfs:comment "c") :a :b :c)
SameIndividual(Annotation(rdfs:comment "e") :a :b :c)
SameIndividual(:a :b :c)
EquivalentDataProperties(Annotation(rdfs:comment "c") :d :e :f)
EquivalentDataProperties(Annotation(rdfs:comment "e") :d :e :f)
EquivalentDataProperties(:d :e :f)
)
