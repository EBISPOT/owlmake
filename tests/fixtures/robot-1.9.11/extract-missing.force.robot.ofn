Prefix(:=<http://example.org/s#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/s>

Declaration(Class(:A))
Declaration(ObjectProperty(:r))
Declaration(NamedIndividual(:P))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#source>))



############################
#   Classes
############################

# Class: :A (a)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:2") rdfs:label :A "a")


############################
#   Named Individuals
############################

# Individual: :P (p)

AnnotationAssertion(rdfs:label :P "p")
ClassAssertion(:A :P)
ObjectPropertyAssertion(:r :P :P)


)