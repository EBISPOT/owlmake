<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/disjoint-union-of-none#"
     xml:base="http://example.org/disjoint-union-of-none"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <owl:Ontology rdf:about="http://example.org/disjoint-union-of-none"/>
    <owl:Class rdf:about="http://example.org/disjoint-union-of-none#U">
        <owl:disjointUnionOf rdf:parseType="Collection"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/disjoint-union-of-none#V">
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/disjoint-union-of-none#B"/>
        </owl:disjointUnionOf>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/disjoint-union-of-none#B"/>
</rdf:RDF>
