Prefix(:=<http://example.org/root.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/root.owl>

Declaration(Class(<http://example.org/ext/B>))
Declaration(Class(<http://example.org/int/A>))


############################
#   Classes
############################

# Class: <http://example.org/int/A> (a)

AnnotationAssertion(rdfs:label <http://example.org/int/A> "a")
SubClassOf(<http://example.org/int/A> <http://example.org/ext/B>)


)