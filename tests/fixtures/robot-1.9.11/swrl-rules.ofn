Prefix(:=<http://example.org/rule#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<http://example.org/rule>
Declaration(Class(:A))
Declaration(Class(:B))
Declaration(Class(:C))
Declaration(ObjectProperty(:p))
Declaration(ObjectProperty(:q))
Declaration(NamedIndividual(:a))
Declaration(NamedIndividual(:b))
ClassAssertion(:A :a)
ObjectPropertyAssertion(:p :a :b)
DLSafeRule(Body(ClassAtom(:A Variable(<urn:swrl:var#x>))) Head(ClassAtom(:B Variable(<urn:swrl:var#x>))))
DLSafeRule(Body(ObjectPropertyAtom(:p Variable(<urn:swrl:var#x>) Variable(<urn:swrl:var#y>))) Head(ObjectPropertyAtom(:q Variable(<urn:swrl:var#y>) Variable(<urn:swrl:var#x>))))
)
