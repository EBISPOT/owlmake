Ontology(<http://x.org/root>

Declaration(Class(efo:EFO_0000998))
Declaration(Class(:LeafComponent))
Declaration(Class(:ReproSystem))
############################
#   Classes
############################

# Class: efo:EFO_0000998 (efo:EFO_0000998)

SubClassOf(efo:EFO_0000998 po:Structure)

# Class: po:Flower (po:Flower)

SubClassOf(po:Flower :ReproSystem)

# Class: po:Leaf (po:Leaf)

SubClassOf(po:Leaf po:Structure)

# Class: po:Organ (po:Organ)

SubClassOf(po:Organ po:Structure)

# Class: po:Perianth (po:Perianth)

SubClassOf(po:Perianth po:Organ)
SubClassOf(po:Perianth :ReproSystem)

# Class: po:Stoma (po:Stoma)

SubClassOf(po:Stoma po:Tissue)
SubClassOf(po:Stoma :LeafComponent)

# Class: po:Structure (po:Structure)

SubClassOf(po:Structure owl:Thing)

# Class: po:Tepal (po:Tepal)

SubClassOf(po:Tepal po:Perianth)

# Class: po:Tissue (po:Tissue)

SubClassOf(po:Tissue po:Structure)

# Class: :LeafComponent (:LeafComponent)

SubClassOf(:LeafComponent po:Structure)

# Class: :ReproSystem (:ReproSystem)

SubClassOf(:ReproSystem po:Structure)


