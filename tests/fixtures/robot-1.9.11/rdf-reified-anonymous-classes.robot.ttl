@prefix : <http://example.com/e#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com/e> .

<http://example.com/e> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.com/e#p
:p rdf:type owl:ObjectProperty .


###  http://example.com/e#q
:q rdf:type owl:ObjectProperty .


###  http://example.com/e#r
:r rdf:type owl:ObjectProperty .


###  http://example.com/e#s
:s rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://example.com/e#A
:A rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :p ;
                        owl:someValuesFrom :A ;
                        owl:equivalentClass _:genid2
                      ] ;
  owl:annotatedProperty owl:equivalentClass ;
  owl:annotatedTarget _:genid2 ;
  rdfs:comment "an equivalent pair"
] .

_:genid2 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :A .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :s ;
                        owl:someValuesFrom :A ;
                        rdfs:subClassOf _:genid5
                      ] ;
  owl:annotatedProperty rdfs:subClassOf ;
  owl:annotatedTarget _:genid5 ;
  rdfs:comment "a general subclass"
] .

_:genid5 rdf:type owl:Restriction ;
          owl:onProperty :q ;
          owl:someValuesFrom :A .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :q ;
                        owl:someValuesFrom :A ;
                        owl:disjointWith _:genid8
                      ] ;
  owl:annotatedProperty owl:disjointWith ;
  owl:annotatedTarget _:genid8 ;
  rdfs:comment "a disjoint pair"
] .

_:genid8 rdf:type owl:Restriction ;
          owl:onProperty :r ;
          owl:someValuesFrom :A .


