[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :t ;
                        owl:someValuesFrom :C ;
                        owl:equivalentClass _:genid59
                      ] ;
  owl:annotatedProperty owl:equivalentClass ;
  owl:annotatedTarget _:genid59 ;
  rdfs:comment "counter"
] .

_:genid59 rdf:type owl:Restriction ;
           owl:onProperty :t ;
           owl:allValuesFrom :C .


[ rdf:type owl:Axiom ;
  owl:annotatedSource [ rdf:type owl:Restriction ;
                        owl:onProperty :p ;
                        owl:someValuesFrom :B ;
                        owl:hasKey _:genid65
                      ] ;
