#################################################################
#    Object Properties
#################################################################

###  http://example.org/v#p
:p rdf:type owl:ObjectProperty ;
   owl:equivalentProperty [ owl:inverseOf :t
                          ] ;
   rdfs:subPropertyOf :q ;
   owl:inverseOf [ owl:inverseOf :s
                 ] ;
   owl:propertyDisjointWith [ owl:inverseOf :r
                            ] ;
   rdfs:label "p" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :p ;
   owl:annotatedProperty rdfs:label ;
   owl:annotatedTarget "p" ;
   rdfs:comment "label"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :p ;
   owl:annotatedProperty rdfs:subPropertyOf ;
   owl:annotatedTarget :q ;
   rdfs:comment "named sub"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :p ;
                         rdf:type owl:FunctionalProperty
                       ] ;
   owl:annotatedProperty rdf:type ;
   owl:annotatedTarget owl:FunctionalProperty ;
   rdfs:comment "functional inverse"
 ] .

[ owl:inverseOf :p ;
   rdf:type owl:TransitiveProperty
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :p ;
                         rdfs:domain :A
                       ] ;
   owl:annotatedProperty rdfs:domain ;
   owl:annotatedTarget :A ;
   rdfs:comment "inverse domain"
 ] .

[ owl:inverseOf :p ;
   rdfs:range :B
 ] .


###  http://example.org/v#q
:q rdf:type owl:ObjectProperty ;
   owl:equivalentProperty _:genid12 ;
   owl:inverseOf _:genid16 .

_:genid12 owl:inverseOf :r .

_:genid16 owl:inverseOf :t .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :q ;
   owl:annotatedProperty owl:equivalentProperty ;
   owl:annotatedTarget _:genid12 ;
   rdfs:comment "equivalent to inverse"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :q ;
                         rdfs:subPropertyOf :s
                       ] ;
   owl:annotatedProperty rdfs:subPropertyOf ;
   owl:annotatedTarget :s ;
   rdfs:comment "inverse sub"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :q ;
   owl:annotatedProperty owl:inverseOf ;
   owl:annotatedTarget _:genid16 ;
   rdfs:comment "inverse of inverse"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :q ;
                         rdfs:range _:genid19
                       ] ;
   owl:annotatedProperty rdfs:range ;
   owl:annotatedTarget _:genid19 ;
   rdfs:comment "inverse range"
 ] .

_:genid19 rdf:type owl:Restriction ;
           owl:onProperty :r ;
           owl:someValuesFrom :C .


###  http://example.org/v#r
:r rdf:type owl:ObjectProperty ;
   rdfs:subPropertyOf [ owl:inverseOf :t
                      ] ;
   owl:propertyDisjointWith _:genid25 .

_:genid25 owl:inverseOf :s .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :r ;
                         rdfs:subPropertyOf _:genid23
                       ] ;
   owl:annotatedProperty rdfs:subPropertyOf ;
   owl:annotatedTarget _:genid23 ;
   rdfs:comment "inverse sub inverse"
 ] .

_:genid23 owl:inverseOf :t .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :r ;
   owl:annotatedProperty owl:propertyDisjointWith ;
   owl:annotatedTarget _:genid25 ;
   rdfs:comment "disjoint from inverse"
 ] .


