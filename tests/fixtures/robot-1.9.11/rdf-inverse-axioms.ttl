###  http://example.org/v#A
:A rdf:type owl:Class ;
   owl:hasKey ( :q
                :r
                [ owl:inverseOf :p
                ]
                :d
                :e
              ) .


###  http://example.org/v#B
:B rdf:type owl:Class ;
   owl:hasKey _:genid39 .

_:genid39 rdf:type rdf:List ;
           rdf:first :r ;
           rdf:rest ( :d
                    ) .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :B ;
   owl:annotatedProperty owl:hasKey ;
   owl:annotatedTarget _:genid39 ;
   rdfs:comment "key"
 ] .


