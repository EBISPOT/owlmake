:s rdf:type owl:ObjectProperty ;
   rdfs:subPropertyOf _:genid30 .

_:genid30 owl:inverseOf :t .

[ rdf:type owl:Axiom ;
   owl:annotatedSource [ owl:inverseOf :s ;
