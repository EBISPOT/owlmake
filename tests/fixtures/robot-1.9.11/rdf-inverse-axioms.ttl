###  http://example.org/v#i
:i rdf:type owl:NamedIndividual .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual :i ;
   owl:assertionProperty :p ;
   owl:targetIndividual :j ;
   rdfs:comment "negative"
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual :i ;
   owl:assertionProperty :p ;
   owl:targetIndividual :j ;
   rdfs:comment "negative again"
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual :i ;
   owl:assertionProperty [ owl:inverseOf :q
                         ] ;
   owl:targetIndividual :j
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual :i ;
   owl:assertionProperty [ owl:inverseOf :r
                         ] ;
   owl:targetIndividual :j ;
   rdfs:comment "negative inverse"
 ] .

[ rdf:type owl:NegativePropertyAssertion ;
   owl:sourceIndividual :i ;
   owl:assertionProperty :d ;
   owl:targetValue 1 ;
   rdfs:comment "negative data"
 ] .


