###  http://example.org/v#D
:D rdf:type owl:Class ;
   owl:disjointUnionOf ( :E
                         [ owl:intersectionOf ( :A
                                                :B
                                              ) ;
                           rdf:type owl:Class
                         ]
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :p ;
                           owl:someValuesFrom :A
                         ]
                       ) .


