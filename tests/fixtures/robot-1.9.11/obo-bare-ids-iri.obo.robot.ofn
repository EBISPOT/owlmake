Prefix(:=<http://example.org/b#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/b>
Annotation(<http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> "1.2")

Declaration(Class(<http://purl.obolibrary.org/obo/http://example.org/b#A>))
Declaration(Class(<http://purl.obolibrary.org/obo/http://example.org/b#B>))
Declaration(Class(<http://purl.obolibrary.org/obo/http://example.org/b#C>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/http://example.org/b#p>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/http://example.org/b#q>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/http://example.org/b#r>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#id>))
############################
#   Annotation Properties
############################

# Annotation Property: <http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> (has_obo_format_version)

AnnotationAssertion(rdfs:label <http://www.geneontology.org/formats/oboInOwl#hasOBOFormatVersion> "has_obo_format_version")

# Annotation Property: <http://www.geneontology.org/formats/oboInOwl#id> (id)

AnnotationAssertion(rdfs:label <http://www.geneontology.org/formats/oboInOwl#id> "id")


############################
#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/http://example.org/b#p> (<http://purl.obolibrary.org/obo/http://example.org/b#p>)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/http://example.org/b#p> "p")
EquivalentObjectProperties(<http://purl.obolibrary.org/obo/http://example.org/b#p> <http://purl.obolibrary.org/obo/http://example.org/b#q>)



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/http://example.org/b#A> (<http://purl.obolibrary.org/obo/http://example.org/b#A>)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/http://example.org/b#A> "A")
SubClassOf(<http://purl.obolibrary.org/obo/http://example.org/b#A> <http://purl.obolibrary.org/obo/http://example.org/b#B>)
SubClassOf(<http://purl.obolibrary.org/obo/http://example.org/b#A> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/http://example.org/b#r> <http://purl.obolibrary.org/obo/http://example.org/b#C>))


)