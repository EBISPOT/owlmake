Prefix(:=<http://example.org/p#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(prov:=<http://www.w3.org/ns/prov#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://example.org/p>
<http://example.org/p/v1>
Annotation(rdfs:comment "p header")

Declaration(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) Class(<http://example.org/A>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) Class(<http://example.org/B>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/s>) Class(<http://example.org/Shared>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) Class(<http://example.org/Shared>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/i>) Class(<http://example.org/X>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/i>) Class(<http://example.org/Y>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/s>) Class(<http://example.org/Z>))
Declaration(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) AnnotationProperty(<http://example.org/ap>))
Declaration(AnnotationProperty(prov:wasDerivedFrom))
############################
#   Annotation Properties
############################

# Annotation Property: <http://example.org/ap> (<http://example.org/ap>)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:isDefinedBy <http://example.org/ap> <http://example.org/p>)

# Annotation Property: prov:wasDerivedFrom (prov:wasDerivedFrom)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:isDefinedBy prov:wasDerivedFrom <http://example.org/p>)



############################
#   Classes
############################

# Class: <http://example.org/A> (A)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) <http://example.org/ap> <http://example.org/A> "v")
AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:isDefinedBy <http://example.org/A> <http://example.org/p>)
AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:label <http://example.org/A> "A")
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) <http://example.org/A> <http://example.org/B>)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/orig>) <http://example.org/A> <http://example.org/X>)

# Class: <http://example.org/B> (<http://example.org/B>)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:isDefinedBy <http://example.org/B> <http://example.org/elsewhere>)
SubClassOf(Annotation(rdfs:comment "c") Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) <http://example.org/B> <http://example.org/X>)

# Class: <http://example.org/Shared> (<http://example.org/Shared>)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:isDefinedBy <http://example.org/Shared> <http://example.org/p>)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/s>) <http://example.org/Shared> <http://example.org/B>)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) <http://example.org/Shared> <http://example.org/B>)

# Class: <http://example.org/X> (X)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:isDefinedBy <http://example.org/X> <http://example.org/i>)
AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/i>) rdfs:label <http://example.org/X> "X")

# Class: <http://example.org/Y> (<http://example.org/Y>)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/p/v1>) rdfs:isDefinedBy <http://example.org/Y> <http://example.org/i>)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/i>) <http://example.org/Y> <http://example.org/X>)

# Class: <http://example.org/Z> (<http://example.org/Z>)

AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/s>) rdfs:isDefinedBy <http://example.org/Z> <http://example.org/j>)
AnnotationAssertion(rdfs:isDefinedBy <http://example.org/Z> <http://example.org/s>)
SubClassOf(Annotation(prov:wasDerivedFrom <http://example.org/s>) <http://example.org/Z> <http://example.org/A>)


AnnotationAssertion(Annotation(prov:wasDerivedFrom <http://example.org/s>) rdfs:isDefinedBy <http://example.org/W> <http://example.org/j>)
)