<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/restated-chain#"
     xml:base="http://example.org/restated-chain"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/restated-chain"/>
    <owl:ObjectProperty rdf:about="http://example.org/restated-chain#p"/>
    <owl:ObjectProperty rdf:about="http://example.org/restated-chain#q"/>
    <owl:ObjectProperty rdf:about="http://example.org/restated-chain#r">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/restated-chain#p"/>
            <rdf:Description rdf:about="http://example.org/restated-chain#q"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/restated-chain#p"/>
            <rdf:Description rdf:about="http://example.org/restated-chain#q"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/restated-chain#r"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
        <owl:annotatedTarget rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/restated-chain#p"/>
            <rdf:Description rdf:about="http://example.org/restated-chain#q"/>
        </owl:annotatedTarget>
        <rdfs:comment>c</rdfs:comment>
    </owl:Axiom>
</rdf:RDF>
