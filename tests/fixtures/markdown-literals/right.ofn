Prefix(:=<http://example.org/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<http://example.org/o.owl>
Declaration(Class(:A))
AnnotationAssertion(rdfs:label :A "a")
AnnotationAssertion(rdfs:comment :A "a<b&c\"d")
AnnotationAssertion(rdfs:comment :A "café α")
AnnotationAssertion(rdfs:comment :A "line1
line2")
AnnotationAssertion(rdfs:comment :A "tab	here")
AnnotationAssertion(rdfs:comment :A "back\\slash")
AnnotationAssertion(rdfs:comment :A "1.50"^^xsd:decimal)
AnnotationAssertion(rdfs:comment :A "2"^^xsd:integer)
AnnotationAssertion(rdfs:comment :A "07"^^xsd:int)
AnnotationAssertion(rdfs:comment :A "true"^^xsd:boolean)
AnnotationAssertion(rdfs:comment :A "1.5"^^xsd:float)
AnnotationAssertion(rdfs:comment :A "1.5"^^xsd:double)
AnnotationAssertion(rdfs:comment :A "x"^^xsd:string)
AnnotationAssertion(rdfs:comment :A "y"@en)
AnnotationAssertion(rdfs:comment :A "z")
AnnotationAssertion(rdfs:comment :A "http://x"^^xsd:anyURI)
)
