AnnotationAssertion(<http://purl.org/dc/terms/title> <http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> "list_xrefs")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "'widget'") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> "xsd:string")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> "xsd:string")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> "xsd:string")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> "xsd:string")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> "c 'widget'.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> "xsd:string")
SubClassOf(<http://purl.obolibrary.org/obo/ex/patterns/list_xrefs.yaml> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/EX_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000001>)))


