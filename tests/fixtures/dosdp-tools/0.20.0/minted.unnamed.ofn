Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<urn:unnamed:ontology#ont1>

Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000002>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000003>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000060>))
Declaration(Class(<urn:dosdp:defined_class>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000051>))



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/EX_0000060> (cog widget c1)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000060> "cog widget c1")
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000060> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000002>))

# Class: <urn:dosdp:defined_class> (gear widget c2)

AnnotationAssertion(rdfs:label <urn:dosdp:defined_class> "gear widget c2")
SubClassOf(<urn:dosdp:defined_class> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000003>))


