#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/EX_0000080> (<http://purl.obolibrary.org/obo/EX_0000080>)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/EX_0000080> "cog def")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/EX_0000080> "n1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/EX_0000080> "n2")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000080> "cog widget")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/EX_0000080> "cog def")
AnnotationAssertion(Annotation(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "deep cog") rdfs:comment "on cog") rdfs:comment <http://purl.obolibrary.org/obo/EX_0000080> "cog thing")
AnnotationAssertion(Annotation(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> <http://purl.obolibrary.org/obo/EX_0000002>) <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "n1") Annotation(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> <http://purl.obolibrary.org/obo/EX_0000002>) <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "n2") rdfs:comment <http://purl.obolibrary.org/obo/EX_0000080> "listed")
SubClassOf(Annotation(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "n1") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "n2") rdfs:comment "because cog") <http://purl.obolibrary.org/obo/EX_0000080> <http://purl.obolibrary.org/obo/EX_0000001>)


)