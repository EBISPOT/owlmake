Prefix(:=<urn:unnamed:ontology#ont1>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<urn:unnamed:ontology#ont1>

Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000002>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000003>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000004>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000010>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000011>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000012>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000051>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym>))



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/EX_0000010> (bog X 2-w$)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000010> "cc")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000010> "gg")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/EX_0000010> "y")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/EX_0000010> "y1")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000010> "B id 0000010")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000010> "bog X 2-w$")
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000002>))

# Class: <http://purl.obolibrary.org/obo/EX_0000011> (gear q q)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000011> "hh")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000011> "gear id 0000011")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000011> "gear q q")
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000011> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000003>))

# Class: <http://purl.obolibrary.org/obo/EX_0000012> (bog a1 1-a$)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000012> "cc")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/EX_0000012> "y")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000012> "B id 0000012")
