Prefix(:=<urn:unnamed:ontology#ont1>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<urn:unnamed:ontology#ont1>

Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000001>))
Declaration(Class(<http://purl.obolibrary.org/obo/ex/patterns/internal.yaml>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/title>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym>))


############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/ex/patterns/internal.yaml> (widget with 'widget')

AnnotationAssertion(<http://purl.org/dc/terms/title> <http://purl.obolibrary.org/obo/ex/patterns/internal.yaml> "internal")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/ex/patterns/internal.yaml> "codes http://www.w3.org/2001/XMLSchema#string")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/ex/patterns/internal.yaml> "refs http://www.w3.org/2001/XMLSchema#string; regex []; 'widget'")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ex/patterns/internal.yaml> "widget with 'widget'")
SubClassOf(<http://purl.obolibrary.org/obo/ex/patterns/internal.yaml> <http://purl.obolibrary.org/obo/EX_0000001>)


)