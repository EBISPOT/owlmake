Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<urn:unnamed:ontology#ont1>

Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000002>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000003>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000010>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000011>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000051>))



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/EX_0000010> (cog widget)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000010> "cog widget"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000002>))

# Class: <http://purl.obolibrary.org/obo/EX_0000011> (gear widget)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000011> "gear widget"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000011> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000003>))


