Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<urn:unnamed:ontology#ont1>

Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000001>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000010>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000011>))
