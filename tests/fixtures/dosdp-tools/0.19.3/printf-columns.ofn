############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/EX_0000010> (cog (cog wheel))

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000010> "EX:0000010 in plain text"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000010> "cog (cog wheel)"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000010> <http://purl.obolibrary.org/obo/EX_0000001>)

# Class: <http://purl.obolibrary.org/obo/EX_0000011> (sprocket (sprocket))

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000011> "EX:0000011 in EX:0000009"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000011> "sprocket (sprocket)"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000011> <http://purl.obolibrary.org/obo/EX_0000001>)

# Class: <http://purl.obolibrary.org/obo/EX_0000012> (gear ())

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000012> "EX:0000012 in "^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000012> "gear ()"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000012> <http://purl.obolibrary.org/obo/EX_0000001>)


