Prefix(:=<urn:unnamed:ontology#ont1>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<urn:unnamed:ontology#ont1>

Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000001>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000002>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000003>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000050>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000051>))
Declaration(Class(<http://purl.obolibrary.org/obo/EX_0000052>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000051>))
Declaration(AnnotationProperty(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym>))



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/EX_0000050> (part gear)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000050> ""^^xsd:string)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000050> "a"^^xsd:string)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000050> "b"^^xsd:string)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000050> "widget"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000050> "part cog"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000050> "part gear"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000050> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000001>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000002>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000003>)))

# Class: <http://purl.obolibrary.org/obo/EX_0000051> (part gear)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000051> ""^^xsd:string)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000051> "x"^^xsd:string)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000051> "cog"^^xsd:string)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/EX_0000051> "gear"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000051> "part gear"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000051> ObjectIntersectionOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000002>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000003>)))

# Class: <http://purl.obolibrary.org/obo/EX_0000052> (part cog)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000052> "solo"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000052> "part cog"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000052> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000002>))


