# Class: <http://purl.obolibrary.org/obo/EX_0000010> (sprocket with cog)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/EX_0000010> "A widget with sprocket, coded c1."^^xsd:string)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000010> "http://purl.obolibrary.org/obo/EX_0000005"^^xsd:string)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/EX_0000010> "sprocket"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/EX_0000010> "sprocket with cog"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/EX_0000010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/EX_0000004>))

